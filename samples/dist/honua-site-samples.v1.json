      },
      "sdk": {
        "package": "@honua/sdk-js",
        "version": "0.1.0-beta.0"
      },
      "capabilities": [
        "aggregation",
        "analysis",
        "bounded-local",
        "explain-plan",
        "linked-views",
        "provenance"
      ],
