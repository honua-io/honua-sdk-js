      "lanes": {
        "fixture": {
          "status": "executed"
        },
        "live": {
          "status": "planned"
        }
      },
      "expectedDegradation": "Remote fixtures are labeled replayed, bounded-local execution is capped, unsafe materialization is rejected, and OGC/DuckDB planner execution is a structured #389 follow-on."
    },
