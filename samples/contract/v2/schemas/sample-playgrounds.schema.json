{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/sample-playgrounds.v1.schema.json",
  "title": "Honua SDK sample playgrounds v1",
  "description": "Zero-install playground decisions for every runnable gallery sample (#958). One record per catalog entry: a generated standalone project with its provider links, or a machine-readable exclusion category. Published as its own artifact rather than as a member of the site projection, because that projection's schema is content-addressed by the committed consumer handoff and may only change under a coordinated version bump.",
  "type": "object",
  "required": ["format", "schemaVersion", "sdk", "playgrounds", "excluded"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.sample-playgrounds.v1" },
    "schemaVersion": { "const": 1 },
    "sdk": {
      "type": "object",
      "required": ["package", "version"],
      "properties": {
        "package": { "const": "@honua/sdk-js" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "playgrounds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["sampleId", "projectPath", "providers", "dataOrigin"],
        "properties": {
          "sampleId": { "$ref": "#/$defs/slug" },
          "projectPath": { "type": "string", "pattern": "^playgrounds/[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "dataOrigin": {
            "description": "Where the generated project's default lane gets its data. `committed-sample-source` means the sample carries its own data; `generated-fixture-service` means the project's Vite dev and preview server answers the listed same-origin routes from byte-identical copies of the named reviewed fixture pack, because the sample's own data origin is a repository process a playground cannot start (#958).",
            "oneOf": [
              {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "committed-sample-source" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "fixturePack", "routes"],
                "properties": {
                  "kind": { "const": "generated-fixture-service" },
                  "fixturePack": { "type": "string", "pattern": "^samples/fixtures/[a-z0-9-]+/v[0-9]+$" },
                  "routes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^/[^?#]*$" }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["id", "title", "url"],
              "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "pattern": "^https://[^?#]+$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["sampleId", "category", "detail"],
        "properties": {
          "sampleId": { "$ref": "#/$defs/slug" },
          "category": {
            "enum": [
              "lifecycle-not-active",
              "unsupported-support-tier",
              "audit-pending",
              "requires-data-origin",
              "shared-repository-source",
              "repository-vite-kit",
              "unpublished-entrypoint",
              "unreleased-sdk-surface",
              "unpinned-dependency",
              "binary-asset",
              "browser-configuration"
            ]
          },
          "detail": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
