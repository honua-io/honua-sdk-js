{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/sample-playgrounds.v1.schema.json",
  "title": "Honua SDK sample playgrounds v1",
  "description": "Zero-install playground decisions for every runnable gallery sample (#958). One record per catalog entry: a generated standalone project with its provider links, or a machine-readable exclusion category. Published as its own artifact rather than as a member of the site projection, because that projection's schema is content-addressed by the committed consumer handoff and may only change under a coordinated version bump.",
  "type": "object",
  "required": ["format", "schemaVersion", "sdk", "playgrounds", "excluded"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.sample-playgrounds.v1" },
    "schemaVersion": { "const": 1 },
    "sdk": {
      "type": "object",
      "required": ["package", "version"],
      "properties": {
        "package": { "const": "@honua/sdk-js" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "playgrounds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["sampleId", "projectPath", "providers"],
        "properties": {
          "sampleId": { "$ref": "#/$defs/slug" },
          "projectPath": { "type": "string", "pattern": "^playgrounds/[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "providers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["id", "title", "url"],
              "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "pattern": "^https://[^?#]+$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["sampleId", "category", "detail"],
        "properties": {
          "sampleId": { "$ref": "#/$defs/slug" },
          "category": {
            "enum": [
              "lifecycle-not-active",
              "unsupported-support-tier",
              "audit-pending",
              "requires-data-origin",
              "shared-repository-source",
              "repository-vite-kit",
              "unpublished-entrypoint",
              "unpinned-dependency",
              "binary-asset",
              "browser-configuration"
            ]
          },
          "detail": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
