{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/sample-gate-receipt.v1.schema.json",
  "title": "Honua SDK sample gate receipt v1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "sampleId",
    "gate",
    "status",
    "sdkMode",
    "sourceRevision",
    "command",
    "producer",
    "observedAt",
    "expiresAt",
    "durationMs",
    "artifacts"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.sample-gate-receipt.v1" },
    "schemaVersion": { "const": 1 },
    "sampleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "gate": {
      "enum": [
        "packed-build",
        "browser",
        "accessibility",
        "console",
        "responsive",
        "screenshot",
        "performance",
        "fixture",
        "live"
      ]
    },
    "status": { "const": "passed" },
    "sdkMode": { "enum": ["source", "packed"] },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "command": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$" }
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": { "const": "honua-sdk-sample-runner" },
        "version": { "const": 1 },
        "path": { "const": "scripts/sample-runner.mjs" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "number", "minimum": 0 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "bytes", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
