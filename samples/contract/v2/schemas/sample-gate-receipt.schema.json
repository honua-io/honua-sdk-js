{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/sample-gate-receipt.v1.schema.json",
  "title": "Honua SDK sample gate receipt v1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "sampleId",
    "gate",
    "status",
    "sdkMode",
    "sourceRevision",
    "sourceDigest",
    "runRoot",
    "command",
    "producer",
    "observedAt",
    "expiresAt",
    "durationMs",
    "artifacts"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.sample-gate-receipt.v1" },
    "schemaVersion": { "const": 1 },
    "sampleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "gate": {
      "enum": [
        "packed-build",
        "browser",
        "accessibility",
        "console",
        "responsive",
        "screenshot",
        "performance",
        "fixture",
        "live"
      ]
    },
    "status": { "const": "passed" },
    "sdkMode": { "enum": ["source", "packed"] },
    "sourceRevision": {
      "description": "Named source commit whose evidence-neutral tree matches sourceDigest and which is an ancestor of validation HEAD.",
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceDigest": {
      "description": "SHA-256 binding for the evidence-neutral source index and revision tree.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runRoot": {
      "description": "Canonical lowercase UUIDv4 per-run root containing every generated artifact bound by this receipt.",
      "type": "string",
      "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/runs/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "command": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$" }
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": { "const": "honua-sdk-sample-runner" },
        "version": { "const": 1 },
        "path": { "const": "scripts/sample-runner.mjs" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "number", "minimum": 0 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "bytes", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "gate": { "const": "packed-build" } },
        "required": ["gate"]
      },
      "then": {
        "properties": { "sdkMode": { "const": "packed" } },
        "required": ["sdkMode"]
      }
    }
  ],
  "additionalProperties": false
}
