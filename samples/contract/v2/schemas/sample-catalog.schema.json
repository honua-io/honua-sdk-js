{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/sample-catalog.v2.schema.json",
  "title": "Honua SDK sample catalog v2",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "migratedFrom",
    "sdk",
    "configuration",
    "goldenJourneys",
    "qualityProfiles",
    "externalReplacements",
    "samples",
    "siteMappings"
  ],
  "properties": {
    "$schema": { "const": "./contract/v2/schemas/sample-catalog.schema.json" },
    "format": { "const": "honua.sdk.sample-catalog.v2" },
    "schemaVersion": { "const": 2 },
    "migratedFrom": {
      "type": "object",
      "required": ["format", "path"],
      "properties": {
        "format": { "const": "honua.sdk.sample-catalog.v1" },
        "path": { "const": "samples/catalog.v1.json" }
      },
      "additionalProperties": false
    },
    "sdk": {
      "type": "object",
      "required": ["package"],
      "properties": { "package": { "const": "@honua/sdk-js" } },
      "additionalProperties": false
    },
    "configuration": { "$ref": "#/$defs/configuration" },
    "goldenJourneys": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/goldenJourney" }
    },
    "qualityProfiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/qualityProfile" }
    },
    "externalReplacements": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalReplacement" }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    },
    "siteMappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/siteMapping" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "configuration": {
      "type": "object",
      "required": [
        "endpointValuePolicy",
        "allowedSchemes",
        "browserSecretPolicy",
        "credentialQueryParameters",
        "evidenceExpiry",
        "environmentReadExemptions"
      ],
      "properties": {
        "endpointValuePolicy": { "const": "environment-name-only" },
        "allowedSchemes": { "const": ["http", "https"] },
        "browserSecretPolicy": { "type": "string", "minLength": 1 },
        "credentialQueryParameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "evidenceExpiry": {
          "type": "object",
          "required": ["executedMaxDays", "nonExecutedMaxDays", "maxFutureSkewSeconds"],
          "properties": {
            "executedMaxDays": { "type": "integer", "minimum": 1 },
            "nonExecutedMaxDays": { "type": "integer", "minimum": 1 },
            "maxFutureSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 }
          },
          "additionalProperties": false
        },
        "environmentReadExemptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["name", "provider", "reason"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
              "provider": { "enum": ["github-actions", "vite"] },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "goldenJourney": {
      "type": "object",
      "required": ["id", "title", "status", "candidateSampleId"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "qualified"] },
        "candidateSampleId": { "$ref": "#/$defs/slug" }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": [
        "packedBuild",
        "browser",
        "accessibility",
        "console",
        "responsive",
        "screenshot",
        "performance",
        "liveEvidence"
      ],
      "properties": {
        "packedBuild": { "type": "boolean" },
        "browser": { "type": "boolean" },
        "accessibility": { "type": "boolean" },
        "console": { "type": "boolean" },
        "responsive": { "type": "boolean" },
        "screenshot": { "type": "boolean" },
        "performance": { "type": "boolean" },
        "liveEvidence": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "qualityProfile": {
      "type": "object",
      "required": ["id", "description", "gates"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "description": { "type": "string", "minLength": 1 },
        "gates": { "$ref": "#/$defs/gates" }
      },
      "additionalProperties": false
    },
    "externalReplacement": {
      "type": "object",
      "required": ["id", "title", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "additionalProperties": false
    },
    "replacement": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["sample", "journey", "external"] },
        "id": { "$ref": "#/$defs/slug" }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": { "enum": ["active", "rework", "merge", "replace", "retire"] },
        "reason": { "type": "string", "minLength": 1 },
        "targetRelease": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "replacement": { "$ref": "#/$defs/replacement" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "active" } } },
          "then": { "not": { "anyOf": [{ "required": ["targetRelease"] }, { "required": ["replacement"] }] } },
          "else": { "required": ["targetRelease"] }
        },
        {
          "if": { "properties": { "state": { "enum": ["merge", "replace", "retire"] } } },
          "then": { "required": ["replacement"] },
          "else": { "not": { "required": ["replacement"] } }
        }
      ],
      "additionalProperties": false
    },
    "evidenceLane": {
      "type": "object",
      "required": ["mode", "status", "commands"],
      "properties": {
        "mode": { "enum": ["fixture", "public-live", "demo-live", "authenticated", "degraded", "unavailable"] },
        "targetMode": { "enum": ["public-live", "demo-live", "authenticated"] },
        "status": { "enum": ["executed", "not-applicable", "planned", "skipped", "credential-unavailable", "failed"] },
        "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidencePath": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "sourceKind",
        "track",
        "supportTier",
        "lifecycle",
        "sourcePath",
        "docsPath",
        "capabilities",
        "capabilityKeys",
        "protocols",
        "renderers",
        "data",
        "evidence",
        "expectedDegradation",
        "validationProfile",
        "validation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sourceKind": { "enum": ["root-example", "docs-example"] },
        "track": { "enum": ["golden", "recipe", "lab", "fixture"] },
        "journeyId": { "$ref": "#/$defs/slug" },
        "supportTier": { "enum": ["supported", "experimental", "internal", "deprecated"] },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "docsPath": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "capabilityKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$" },
          "description": "Canonical honua-server capability-keys.v1.json keys this entry's `capabilities` slugs crosswalk to (config/capability-crosswalk.v1.json, #635). May be empty only when every capabilities slug is crosswalked as internalOnly."
        },
        "protocols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "renderers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "data": {
          "type": "object",
          "required": ["mode", "authMode", "configurationStatus", "config", "configClassifications", "provenance", "attribution", "freshness"],
          "properties": {
            "mode": { "enum": ["fixture", "public-live", "demo-live", "authenticated-live", "hybrid", "none"] },
            "authMode": { "enum": ["none", "anonymous", "api-key", "bearer", "oauth", "host-mediated"] },
            "configurationStatus": { "enum": ["approved", "not-required", "legacy-unsafe"] },
            "configurationGap": { "type": "string", "minLength": 1 },
            "config": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
            "configClassifications": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["name", "exposure", "valueKind"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                  "exposure": { "enum": ["browser-public", "server-only"] },
                  "valueKind": { "enum": ["credential", "non-secret"] },
                  "credentialScope": { "enum": ["public-token", "secret"] }
                },
                "allOf": [
                  {
                    "if": { "properties": { "valueKind": { "const": "credential" } } },
                    "then": { "required": ["credentialScope"] },
                    "else": { "not": { "required": ["credentialScope"] } }
                  }
                ],
                "additionalProperties": false
              }
            },
            "provenance": { "type": "string", "minLength": 1 },
            "attribution": { "type": "string", "minLength": 1 },
            "freshness": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "configurationStatus": { "const": "approved" } } },
              "then": {
                "properties": { "config": { "minItems": 1 }, "configClassifications": { "minItems": 1 } },
                "not": { "required": ["configurationGap"] }
              }
            },
            {
              "if": { "properties": { "configurationStatus": { "const": "legacy-unsafe" } } },
              "then": {
                "required": ["configurationGap"]
              },
              "else": {
                "if": { "properties": { "configurationStatus": { "const": "not-required" } } },
                "then": {
                  "properties": { "config": { "maxItems": 0 }, "configClassifications": { "maxItems": 0 } },
                  "not": { "required": ["configurationGap"] }
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "required": ["fixture", "live"],
          "properties": {
            "fixture": { "$ref": "#/$defs/evidenceLane" },
            "live": { "$ref": "#/$defs/evidenceLane" }
          },
          "additionalProperties": false
        },
        "expectedDegradation": { "type": "string" },
        "validationProfile": { "$ref": "#/$defs/slug" },
        "validation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "track": { "const": "golden" } } },
          "then": { "required": ["journeyId"] }
        }
      ],
      "additionalProperties": false
    },
    "siteMapping": {
      "type": "object",
      "required": ["id", "route", "ownership"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "route": { "type": "string", "pattern": "^[-a-z0-9]+\\.html$" },
        "ownership": { "enum": ["sdk-projection", "site-exception"] },
        "sampleId": { "$ref": "#/$defs/slug" },
        "exceptionReason": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "track": { "enum": ["golden", "recipe", "lab", "fixture"] },
        "supportTier": { "enum": ["supported", "experimental", "internal", "deprecated"] },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
