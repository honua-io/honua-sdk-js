{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/capability-sample-matrix.v1.schema.json",
  "title": "Honua SDK capability-to-sample matrix v1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "sdk",
    "inputs",
    "statusVocabulary",
    "dimensions",
    "goldenJourneys",
    "samples",
    "protocolOperations",
    "supportClaims",
    "entrypoints",
    "gaps"
  ],
  "properties": {
    "format": { "const": "honua.site.sdk-capability-sample-matrix.v1" },
    "schemaVersion": { "const": 1 },
    "sdk": {
      "type": "object",
      "required": ["package", "version"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["supportManifest", "catalog", "package", "sampleKit", "visualEvidence"],
      "properties": {
        "supportManifest": { "$ref": "#/$defs/versionedInput" },
        "catalog": { "$ref": "#/$defs/versionedInput" },
        "package": { "$ref": "#/$defs/input" },
        "sampleKit": { "$ref": "#/$defs/versionedInput" },
        "visualEvidence": { "$ref": "#/$defs/versionedInput" }
      },
      "additionalProperties": false
    },
    "statusVocabulary": {
      "type": "object",
      "required": ["coverage", "support"],
      "properties": {
        "coverage": { "const": ["qualified", "partial", "planned", "experimental", "unsupported"] },
        "support": { "const": ["supported", "beta", "experimental", "facade-required", "deprecated"] }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": ["tasks", "protocols", "renderers", "dataModes", "authModes", "supportTiers", "lifecycleStates"],
      "properties": {
        "tasks": { "$ref": "#/$defs/nonEmptyStringArray" },
        "protocols": { "$ref": "#/$defs/nonEmptyStringArray" },
        "renderers": { "$ref": "#/$defs/nonEmptyStringArray" },
        "dataModes": { "$ref": "#/$defs/nonEmptyStringArray" },
        "authModes": { "$ref": "#/$defs/nonEmptyStringArray" },
        "supportTiers": { "$ref": "#/$defs/nonEmptyStringArray" },
        "lifecycleStates": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": false
    },
    "goldenJourneys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "candidateSampleId", "catalogStatus", "coverageState"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/nonEmptyString" },
          "candidateSampleId": { "$ref": "#/$defs/id" },
          "catalogStatus": { "enum": ["planned", "qualified"] },
          "coverageState": { "enum": ["planned", "qualified"] }
        },
        "additionalProperties": false
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    },
    "protocolOperations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protocolOperation" }
    },
    "supportClaims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/supportClaim" }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entrypoint" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-zA-Z0-9]*(?:[.:/-][a-zA-Z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "supportStatus": { "enum": ["supported", "beta", "experimental", "facade-required", "deprecated"] },
    "coverageState": { "enum": ["qualified", "partial", "planned", "experimental", "unsupported"] },
    "input": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "versionedInput": {
      "type": "object",
      "required": ["path", "format", "schemaVersion", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "format": { "$ref": "#/$defs/nonEmptyString" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": { "$ref": "#/$defs/coverageState" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "qualificationEvidence": {
      "type": "object",
      "required": ["sourceRevision", "observedAt", "expiresAt", "semanticGates", "screenshotVariants"],
      "properties": {
        "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "semanticGates": { "$ref": "#/$defs/nonEmptyStringArray" },
        "screenshotVariants": { "const": ["desktop", "mobile"] }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "id", "title", "sourcePath", "track", "tasks", "protocolTokens", "protocolIds", "renderers",
        "dataMode", "authMode", "supportTier", "lifecycleState", "qualification"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "sourcePath": { "$ref": "#/$defs/nonEmptyString" },
        "track": { "enum": ["golden", "recipe", "lab", "fixture"] },
        "journeyId": { "$ref": "#/$defs/id" },
        "tasks": { "$ref": "#/$defs/nonEmptyStringArray" },
        "protocolTokens": { "$ref": "#/$defs/nonEmptyStringArray" },
        "protocolIds": { "$ref": "#/$defs/stringArray" },
        "renderers": { "$ref": "#/$defs/nonEmptyStringArray" },
        "dataMode": { "$ref": "#/$defs/nonEmptyString" },
        "authMode": { "$ref": "#/$defs/nonEmptyString" },
        "supportTier": { "$ref": "#/$defs/nonEmptyString" },
        "lifecycleState": { "$ref": "#/$defs/nonEmptyString" },
        "qualification": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["qualified", "partial", "planned"] },
            "evidence": { "$ref": "#/$defs/qualificationEvidence" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "protocolOperation": {
      "type": "object",
      "required": [
        "id", "protocolId", "protocolLabel", "operation", "supportStatus", "environment", "executionMode",
        "truthEvidence", "candidateSampleIds", "qualifyingSampleIds", "coverage"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "protocolId": { "$ref": "#/$defs/id" },
        "protocolLabel": { "$ref": "#/$defs/nonEmptyString" },
        "operation": { "$ref": "#/$defs/id" },
        "supportStatus": { "$ref": "#/$defs/supportStatus" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "executionMode": { "$ref": "#/$defs/nonEmptyString" },
        "truthEvidence": { "$ref": "#/$defs/nonEmptyStringArray" },
        "candidateSampleIds": { "$ref": "#/$defs/stringArray" },
        "qualifyingSampleIds": { "$ref": "#/$defs/stringArray" },
        "coverage": { "$ref": "#/$defs/coverage" }
      },
      "additionalProperties": false
    },
    "candidateEvidence": {
      "type": "object",
      "required": ["sampleId", "matchedOperations"],
      "properties": {
        "sampleId": { "$ref": "#/$defs/id" },
        "matchedOperations": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": false
    },
    "supportClaim": {
      "type": "object",
      "required": [
        "id", "label", "operations", "supportStatus", "environment", "executionMode", "api", "truthEvidence",
        "candidateEvidence", "fullyQualifiedSampleIds", "coverage"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "protocolId": { "$ref": "#/$defs/id" },
        "operations": { "$ref": "#/$defs/nonEmptyStringArray" },
        "supportStatus": { "$ref": "#/$defs/supportStatus" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "executionMode": { "$ref": "#/$defs/nonEmptyString" },
        "api": { "$ref": "#/$defs/nonEmptyString" },
        "truthEvidence": { "$ref": "#/$defs/stringArray" },
        "candidateEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidateEvidence" }
        },
        "fullyQualifiedSampleIds": { "$ref": "#/$defs/stringArray" },
        "coverage": { "$ref": "#/$defs/coverage" }
      },
      "additionalProperties": false
    },
    "entrypoint": {
      "type": "object",
      "required": ["subpath", "supportStatus", "exportPresent", "candidateSampleIds", "qualifyingSampleIds", "coverage"],
      "properties": {
        "subpath": { "$ref": "#/$defs/nonEmptyString" },
        "supportStatus": { "$ref": "#/$defs/supportStatus" },
        "exportPresent": { "const": true },
        "replacement": { "$ref": "#/$defs/nonEmptyString" },
        "candidateSampleIds": { "$ref": "#/$defs/stringArray" },
        "qualifyingSampleIds": { "$ref": "#/$defs/stringArray" },
        "coverage": { "$ref": "#/$defs/coverage" }
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": ["targetType", "targetId", "supportStatus", "coverageState", "candidateSampleIds", "reason"],
      "properties": {
        "targetType": { "enum": ["golden-journey", "protocol-operation", "support-claim", "package-entrypoint"] },
        "targetId": { "$ref": "#/$defs/nonEmptyString" },
        "supportStatus": { "$ref": "#/$defs/supportStatus" },
        "coverageState": { "$ref": "#/$defs/coverageState" },
        "candidateSampleIds": { "$ref": "#/$defs/stringArray" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
