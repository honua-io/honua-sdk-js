{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/catalog-migration.v1-to-v2.schema.json",
  "title": "Honua SDK sample catalog v1 to v2 migration",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "source",
    "target",
    "targetRelease",
    "configuration",
    "goldenJourneys",
    "qualityProfiles",
    "externalReplacements",
    "sampleOverrides",
    "siteMappingOverrides",
    "addedSamples"
  ],
  "properties": {
    "$schema": { "const": "../schemas/catalog-migration.schema.json" },
    "format": { "const": "honua.sdk.sample-catalog-migration.v1-to-v2" },
    "schemaVersion": { "const": 1 },
    "source": { "const": "samples/catalog.v1.json" },
    "target": { "const": "samples/catalog.v2.json" },
    "targetRelease": { "type": "string" },
    "configuration": { "type": "object" },
    "goldenJourneys": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "candidateSampleId"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["planned", "qualified"] },
          "candidateSampleId": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "qualityProfiles": { "type": "array", "minItems": 1 },
    "externalReplacements": { "type": "array" },
    "sampleOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["track", "validationProfile"],
        "properties": {
          "track": { "enum": ["golden", "recipe", "lab", "fixture"] },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "journeyId": { "type": "string" },
          "playground": {
            "description": "Generated by scripts/sample-playgrounds.mjs; projected verbatim into the catalog entry. Never hand-edited.",
            "type": "object",
            "required": ["projectPath", "providers"],
            "properties": {
              "projectPath": { "type": "string", "minLength": 1 },
              "providers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "title", "url"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "title": { "type": "string", "minLength": 1 },
                    "url": { "type": "string", "pattern": "^https://[^?#]+$" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "protocols": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "renderers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "data": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["fixture", "public-live", "demo-live", "authenticated-live", "hybrid", "none"] },
              "authMode": { "enum": ["none", "anonymous", "api-key", "bearer", "oauth", "host-mediated"] },
              "provenance": { "type": "string" },
              "attribution": { "type": "string" },
              "freshness": { "type": "string" }
            },
            "additionalProperties": false
          },
          "expectedDegradation": { "type": "string" },
          "validationProfile": { "type": "string" },
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "replacement": { "type": "object" },
          "configuration": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "enum": ["approved", "not-required", "legacy-unsafe"] },
              "gap": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "lifecycle": {
            "type": "object",
            "required": ["state", "reason"],
            "properties": {
              "state": { "enum": ["active", "rework", "merge", "replace", "retire"] },
              "reason": { "type": "string", "minLength": 1 },
              "replacement": { "type": "object" }
            },
            "additionalProperties": false
          },
          "fixture": {
            "type": "object",
            "properties": {
              "status": { "enum": ["executed", "not-applicable", "planned"] },
              "commands": { "type": "array", "items": { "type": "string" } },
              "evidencePath": { "type": "string" }
            },
            "additionalProperties": false
          },
          "live": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["public-live", "demo-live", "authenticated", "degraded", "unavailable"] },
              "targetMode": { "enum": ["public-live", "demo-live", "authenticated"] },
              "status": {
                "enum": ["executed", "not-applicable", "planned", "skipped", "credential-unavailable", "failed"]
              },
              "commands": { "type": "array", "items": { "type": "string" } },
              "evidencePath": { "type": "string" },
              "expiresAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "siteMappingOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sampleId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "addedSamples": { "type": "array" }
  },
  "additionalProperties": false
}
