{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/golden-journey-visual-evidence.v1.schema.json",
  "title": "Honua SDK golden journey visual evidence v1",
  "type": "object",
  "required": ["format", "schemaVersion", "inputs", "policy", "qualifiedGoldenJourneys"],
  "properties": {
    "format": { "const": "honua.sdk.golden-journey-visual-evidence.v1" },
    "schemaVersion": { "const": 1 },
    "inputs": {
      "type": "object",
      "required": ["catalog", "qualificationEvidence"],
      "properties": {
        "catalog": {
          "type": "object",
          "required": ["path", "format", "schemaVersion", "sha256"],
          "properties": {
            "path": { "const": "samples/catalog.v2.json" },
            "format": { "const": "honua.sdk.sample-catalog.v2" },
            "schemaVersion": { "const": 2 },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "qualificationEvidence": {
          "type": "object",
          "required": ["format", "schemaVersion", "sha256"],
          "properties": {
            "format": { "const": "honua.sdk.sample-qualification-evidence.v1" },
            "schemaVersion": { "const": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "sourceRepository",
        "requiredScreenshotVariants",
        "screenshotReproducibility",
        "requiredSemanticGates",
        "freshness"
      ],
      "properties": {
        "sourceRepository": { "const": "honua-io/honua-sdk-js" },
        "requiredScreenshotVariants": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "required": ["id", "viewport"],
              "properties": {
                "id": { "const": "desktop" },
                "viewport": { "$ref": "#/$defs/desktopViewport" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["id", "viewport"],
              "properties": {
                "id": { "const": "mobile" },
                "viewport": { "$ref": "#/$defs/mobileViewport" }
              },
              "additionalProperties": false
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "screenshotReproducibility": {
          "type": "object",
          "required": [
            "reportFormat",
            "captureCount",
            "comparison",
            "scope",
            "animations",
            "stabilization",
            "runtimeBinding"
          ],
          "properties": {
            "reportFormat": { "const": "honua.sdk.sample-screenshot-gate.v3" },
            "captureCount": { "const": 2 },
            "comparison": { "const": "byte-identical" },
            "scope": { "const": "same-page-session" },
            "animations": { "const": "disabled" },
            "stabilization": {
              "const": ["fonts-ready", "scroll-origin", "double-animation-frame"]
            },
            "runtimeBinding": {
              "const": [
                "playwright-version",
                "project-name",
                "browser-name",
                "browser-version",
                "platform",
                "architecture"
              ]
            }
          },
          "additionalProperties": false
        },
        "requiredSemanticGates": {
          "const": [
            "packed-build",
            "browser",
            "accessibility",
            "console",
            "responsive",
            "screenshot",
            "performance",
            "fixture",
            "live"
          ]
        },
        "freshness": {
          "type": "object",
          "required": ["maxFutureSkewSeconds", "maxWindowSeconds"],
          "properties": {
            "maxFutureSkewSeconds": { "const": 300 },
            "maxWindowSeconds": { "const": 604800 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "qualifiedGoldenJourneys": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualifiedJourney" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "desktopViewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "const": 1280 }, "height": { "const": 720 } },
      "additionalProperties": false
    },
    "mobileViewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "const": 390 }, "height": { "const": 844 } },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "playwrightVersion",
        "projectName",
        "browserName",
        "browserVersion",
        "platform",
        "architecture"
      ],
      "properties": {
        "playwrightVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$" },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "browserName": { "enum": ["chromium", "firefox", "webkit"] },
        "browserVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "architecture": { "type": "string", "pattern": "^[a-z0-9_-]+$" }
      },
      "additionalProperties": false
    },
    "screenshot": {
      "type": "object",
      "required": [
        "variant",
        "projectName",
        "browserName",
        "sourcePath",
        "mediaType",
        "viewport",
        "bytes",
        "sha256",
        "reproducibility"
      ],
      "properties": {
        "variant": { "enum": ["desktop", "mobile"] },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "browserName": { "enum": ["chromium", "firefox", "webkit"] },
        "sourcePath": { "$ref": "#/$defs/screenshotPath" },
        "mediaType": { "const": "image/png" },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "reproducibility": {
          "type": "object",
          "required": ["captureCount", "comparison", "repeatSourcePath", "repeatBytes", "repeatSha256"],
          "properties": {
            "captureCount": { "const": 2 },
            "comparison": { "const": "byte-identical" },
            "repeatSourcePath": { "$ref": "#/$defs/repeatScreenshotPath" },
            "repeatBytes": { "type": "integer", "minimum": 1 },
            "repeatSha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "screenshotPath": {
      "type": "string",
      "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/runs/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/artifacts/screenshot-(?:desktop|mobile)\\.png$"
    },
    "repeatScreenshotPath": {
      "type": "string",
      "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/runs/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/artifacts/screenshot-(?:desktop|mobile)-repeat\\.png$"
    },
    "semanticEvidence": {
      "type": "object",
      "required": [
        "gate",
        "sdkMode",
        "receiptPath",
        "receiptSha256",
        "runRoot",
        "observedAt",
        "expiresAt",
        "reportKind",
        "reportPath",
        "reportBytes",
        "reportSha256"
      ],
      "properties": {
        "gate": {
          "enum": [
            "packed-build",
            "browser",
            "accessibility",
            "console",
            "responsive",
            "screenshot",
            "performance",
            "fixture",
            "live"
          ]
        },
        "sdkMode": { "enum": ["source", "packed"] },
        "receiptPath": {
          "type": "string",
          "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/receipts/[a-z-]+\\.v1\\.json$"
        },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "runRoot": {
          "type": "string",
          "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/runs/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "expiresAt": { "$ref": "#/$defs/dateTime" },
        "reportKind": { "type": "string", "minLength": 1 },
        "reportPath": {
          "type": "string",
          "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/runs/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/artifacts/[a-z0-9._-]+$"
        },
        "reportBytes": { "type": "integer", "minimum": 1 },
        "reportSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "liveEvidence": {
      "type": "object",
      "required": [
        "mode",
        "status",
        "observedAt",
        "expiresAt",
        "evidencePath",
        "provenance",
        "semantics",
        "timing",
        "degradation"
      ],
      "properties": {
        "mode": { "enum": ["public-live", "demo-live", "authenticated"] },
        "status": { "const": "executed" },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "expiresAt": { "$ref": "#/$defs/dateTime" },
        "evidencePath": {
          "type": "string",
          "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/runs/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/artifacts/live-evidence\\.json$"
        },
        "provenance": {
          "type": "object",
          "required": ["state", "observedAt", "attribution"],
          "properties": {
            "state": { "const": "live" },
            "observedAt": { "$ref": "#/$defs/dateTime" },
            "attribution": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "semantics": {
          "type": "object",
          "required": ["operation", "outcome", "itemCount", "assertions"],
          "properties": {
            "operation": { "type": "string", "minLength": 1 },
            "outcome": { "type": "string", "minLength": 1 },
            "itemCount": { "type": "integer", "minimum": 1 },
            "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "required": ["totalMs"],
          "properties": { "totalMs": { "type": "number", "minimum": 0 } },
          "additionalProperties": false
        },
        "degradation": {
          "type": "object",
          "required": ["state", "reasons"],
          "properties": {
            "state": { "enum": ["none", "expected"] },
            "reasons": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "realtime": {
          "type": "object",
          "required": ["observationWindowMs", "snapshotAt", "cursor", "lagMs"],
          "properties": {
            "observationWindowMs": { "type": "number", "exclusiveMinimum": 0 },
            "snapshotAt": { "type": ["string", "null"] },
            "cursor": { "type": ["string", "null"] },
            "lagMs": { "type": ["number", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "qualifiedJourney": {
      "type": "object",
      "required": [
        "journeyId",
        "sampleId",
        "source",
        "runtime",
        "observedAt",
        "expiresAt",
        "screenshots",
        "semanticEvidence",
        "liveEvidence"
      ],
      "properties": {
        "journeyId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sampleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "source": {
          "type": "object",
          "required": ["repository", "path", "revision", "evidenceNeutralSha256"],
          "properties": {
            "repository": { "const": "honua-io/honua-sdk-js" },
            "path": { "type": "string", "pattern": "^(?:examples|docs/examples)/[a-z0-9._/-]+$" },
            "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "evidenceNeutralSha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "runtime": { "$ref": "#/$defs/runtime" },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "expiresAt": { "$ref": "#/$defs/dateTime" },
        "screenshots": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/screenshot" },
                {
                  "properties": {
                    "variant": { "const": "desktop" },
                    "viewport": { "$ref": "#/$defs/desktopViewport" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/screenshot" },
                {
                  "properties": {
                    "variant": { "const": "mobile" },
                    "viewport": { "$ref": "#/$defs/mobileViewport" }
                  }
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "semanticEvidence": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/semanticEvidence" }
        },
        "liveEvidence": { "$ref": "#/$defs/liveEvidence" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
