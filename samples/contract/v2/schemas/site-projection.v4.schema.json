{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/site-sample-projection.v4.schema.json",
  "title": "Honua site SDK sample projection v4",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "catalog",
    "contract",
    "goldenJourneys",
    "externalReplacements",
    "qualityProfiles",
    "samples",
    "routes",
    "sampleBundles"
  ],
  "properties": {
    "format": {
      "const": "honua.site.sdk-sample-projection.v4"
    },
    "schemaVersion": {
      "const": 4
    },
    "catalog": {
      "type": "object",
      "required": ["format", "schemaVersion", "package", "version"],
      "properties": {
        "format": {
          "const": "honua.sdk.sample-catalog.v2"
        },
        "schemaVersion": {
          "const": 2
        },
        "package": {
          "const": "@honua/sdk-js"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["producer", "consumer", "executableSourceOwner", "presentationOwner"],
      "properties": {
        "producer": {
          "const": "honua-io/honua-sdk-js#540"
        },
        "consumer": {
          "const": "honua-io/honua-sdk-js#550"
        },
        "executableSourceOwner": {
          "const": "honua-io/honua-sdk-js"
        },
        "presentationOwner": {
          "const": "honua-io/honua-site"
        }
      },
      "additionalProperties": false
    },
    "goldenJourneys": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/goldenJourney"
      }
    },
    "externalReplacements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalReplacement"
      }
    },
    "qualityProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qualityProfile"
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "sampleBundles": {
      "$ref": "#/$defs/sampleBundles"
    }
  },
  "$defs": {
    "goldenJourney": {
      "type": "object",
      "required": ["id", "title", "status", "candidateSampleId"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": ["planned", "qualified"]
        },
        "candidateSampleId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "externalReplacement": {
      "type": "object",
      "required": ["id", "title", "url"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": [
        "packedBuild",
        "browser",
        "accessibility",
        "console",
        "responsive",
        "screenshot",
        "performance",
        "liveEvidence"
      ],
      "properties": {
        "packedBuild": {
          "type": "boolean"
        },
        "browser": {
          "type": "boolean"
        },
        "accessibility": {
          "type": "boolean"
        },
        "console": {
          "type": "boolean"
        },
        "responsive": {
          "type": "boolean"
        },
        "screenshot": {
          "type": "boolean"
        },
        "performance": {
          "type": "boolean"
        },
        "liveEvidence": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "qualityProfile": {
      "type": "object",
      "required": ["id", "description", "gates"],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "gates": {
          "$ref": "#/$defs/gates"
        }
      },
      "additionalProperties": false
    },
    "replacement": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["sample", "journey", "external"]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "enum": ["active", "rework", "merge", "replace", "retire"]
        },
        "reason": {
          "type": "string"
        },
        "targetRelease": {
          "type": "string"
        },
        "replacement": {
          "$ref": "#/$defs/replacement"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["targetRelease"]
                },
                {
                  "required": ["replacement"]
                }
              ]
            }
          },
          "else": {
            "required": ["targetRelease"]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["merge", "replace", "retire"]
              }
            }
          },
          "then": {
            "required": ["replacement"]
          },
          "else": {
            "not": {
              "required": ["replacement"]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["repository", "path", "docsPath"],
      "properties": {
        "repository": {
          "const": "honua-io/honua-sdk-js"
        },
        "path": {
          "type": "string"
        },
        "docsPath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sdk": {
      "type": "object",
      "required": ["package", "version"],
      "properties": {
        "package": {
          "const": "@honua/sdk-js"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "publicData": {
      "type": "object",
      "required": ["mode", "authMode", "provenance", "attribution", "freshness", "configurationStatus"],
      "properties": {
        "mode": {
          "enum": ["fixture", "public-live", "demo-live", "authenticated-live", "hybrid", "none"]
        },
        "authMode": {
          "enum": ["none", "anonymous", "api-key", "bearer", "oauth", "host-mediated"]
        },
        "provenance": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "configurationStatus": {
          "enum": ["approved", "not-required", "legacy-unsafe"]
        },
        "configurationGap": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "configurationStatus": {
                "const": "legacy-unsafe"
              }
            }
          },
          "then": {
            "required": ["configurationGap"]
          },
          "else": {
            "not": {
              "required": ["configurationGap"]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "fixtureEvidence": {
      "type": "object",
      "required": ["mode", "status"],
      "properties": {
        "mode": {
          "const": "fixture"
        },
        "status": {
          "enum": ["executed", "not-applicable", "planned"]
        }
      },
      "additionalProperties": false
    },
    "liveEvidence": {
      "type": "object",
      "required": ["mode", "status"],
      "properties": {
        "mode": {
          "enum": ["public-live", "demo-live", "authenticated", "degraded", "unavailable"]
        },
        "targetMode": {
          "enum": ["public-live", "demo-live", "authenticated"]
        },
        "status": {
          "enum": ["executed", "not-applicable", "planned", "skipped", "credential-unavailable", "failed"]
        },
        "evidencePath": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["executed", "skipped", "credential-unavailable", "failed"]
              }
            }
          },
          "then": {
            "required": ["evidencePath", "expiresAt"]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["evidencePath"]
                },
                {
                  "required": ["expiresAt"]
                },
                {
                  "required": ["targetMode"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["skipped", "credential-unavailable", "failed"]
              }
            }
          },
          "then": {
            "required": ["targetMode"],
            "properties": {
              "mode": {
                "enum": ["degraded", "unavailable"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "executed"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "enum": ["public-live", "demo-live", "authenticated"]
              }
            },
            "not": {
              "required": ["targetMode"]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "sourceKind",
        "track",
        "supportTier",
        "lifecycle",
        "validationProfile",
        "source",
        "sdk",
        "capabilities",
        "capabilityKeys",
        "protocols",
        "renderers",
        "data",
        "evidence",
        "expectedDegradation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "sourceKind": {
          "enum": ["root-example", "docs-example"]
        },
        "track": {
          "enum": ["golden", "recipe", "lab", "fixture"]
        },
        "journeyId": {
          "type": "string"
        },
        "supportTier": {
          "enum": ["supported", "experimental", "internal", "deprecated"]
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "validationProfile": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "sdk": {
          "$ref": "#/$defs/sdk"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "capabilityKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
          }
        },
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "renderers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "data": {
          "$ref": "#/$defs/publicData"
        },
        "evidence": {
          "type": "object",
          "required": ["fixture", "live"],
          "properties": {
            "fixture": {
              "$ref": "#/$defs/fixtureEvidence"
            },
            "live": {
              "$ref": "#/$defs/liveEvidence"
            }
          },
          "additionalProperties": false
        },
        "expectedDegradation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["id", "route", "ownership"],
      "properties": {
        "id": {
          "type": "string"
        },
        "route": {
          "type": "string",
          "pattern": "^[-a-z0-9]+\\.html$"
        },
        "ownership": {
          "enum": ["sdk-projection", "site-exception"]
        },
        "sampleId": {
          "type": "string"
        },
        "exceptionReason": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "track": {
          "enum": ["golden", "recipe", "lab", "fixture"]
        },
        "supportTier": {
          "enum": ["supported", "experimental", "internal", "deprecated"]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "ownership": {
              "const": "sdk-projection"
            }
          },
          "required": ["sampleId"],
          "not": {
            "anyOf": [
              {
                "required": ["exceptionReason"]
              },
              {
                "required": ["title"]
              },
              {
                "required": ["summary"]
              },
              {
                "required": ["track"]
              },
              {
                "required": ["supportTier"]
              },
              {
                "required": ["capabilities"]
              }
            ]
          }
        },
        {
          "properties": {
            "ownership": {
              "const": "site-exception"
            }
          },
          "required": ["exceptionReason", "title", "summary", "track", "supportTier", "capabilities"],
          "not": {
            "required": ["sampleId"]
          }
        }
      ],
      "additionalProperties": false
    },
    "sampleBundles": {
      "type": "object",
      "required": ["format", "schemaVersion", "publication", "sampleIds"],
      "properties": {
        "format": {
          "description": "Format of the bundle manifest this projection points at. Generation always emits `honua.sdk.sample-bundles.v2` (honua-io/honua-sdk-js#656); `...v1` remains accepted only so the currently-committed samples/dist/honua-site-samples.v2.json -- generated before the cutover and deliberately not resealed by a feature PR, per the derived-artifact decoupling policy in docs/sample-bundles.md -- stays schema-valid until the next regenerate-derived-artifacts.yml run. Tighten back to a v2 const once that reseal has landed.",
          "enum": ["honua.sdk.sample-bundles.v1", "honua.sdk.sample-bundles.v2"]
        },
        "schemaVersion": {
          "enum": [1, 2]
        },
        "publication": {
          "type": "object",
          "required": ["repo", "releaseTagTemplate", "manifestAsset", "bundleAsset"],
          "properties": {
            "repo": {
              "type": "string"
            },
            "releaseTagTemplate": {
              "type": "string",
              "const": "sample-bundles-{sourceCommit}",
              "description": "Template, not a literal tag. Substitute `{sourceCommit}` with the full 40-character source SHA whose bundles you want; publication is content-addressed, one immutable release per source commit. A consumer that uses this string verbatim resolves nothing, which is deliberate -- it fails loudly rather than silently serving stale bytes, the defect that froze the retired `sample-bundles-latest` pointer."
            },
            "manifestAsset": {
              "type": "string"
            },
            "bundleAsset": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "`additionalProperties: false` together with the required `releaseTagTemplate` is what rejects the v3 `releaseTag` spelling, so a v3 payload cannot validate as v4 by accident."
        },
        "sampleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "published": {
          "type": "array",
          "description": "Per-bundle publication truth for every id in sampleIds, so a gallery card can state runtime prerequisites without fetching the bundle manifest. `requires-host-fixture-service` needs the declared hostFixtureRoutes; `requires-live-endpoint` depends on an audited, semantically smoked external service and must never be labeled standalone.",
          "items": {
            "type": "object",
            "required": ["id", "runnability", "hostFixtureRoutes"],
            "properties": {
              "id": {
                "type": "string"
              },
              "runnability": {
                "type": "string",
                "enum": ["standalone", "requires-host-fixture-service", "requires-live-endpoint"]
              },
              "hostFixtureRoutes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "excluded": {
          "type": "array",
          "description": "Every catalog sample id not in sampleIds, with a machine-readable exclusion reason (honua-io/honua-sdk-js#656 REQ-004).",
          "items": {
            "type": "object",
            "required": ["id", "category", "reason"],
            "properties": {
              "id": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "enum": [
                  "needs-prepare-step",
                  "requires-api-key",
                  "requires-live-backend",
                  "requires-companion-server",
                  "replay-mode-undecided",
                  "agent-shaped",
                  "non-browser-app",
                  "non-runtime-sample",
                  "lifecycle-not-active",
                  "legacy-unsafe-configuration",
                  "unsupported-support-tier",
                  "audit-pending"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Identical to v3 except that `sampleBundles.publication.releaseTag` is renamed to `releaseTagTemplate`. The value has carried a template requiring `{sourceCommit}` substitution since honua-io/honua-sdk-js#1325 replaced the frozen `sample-bundles-latest` pointer with a content-addressed one; `releaseTag` implied a literal tag a consumer could use verbatim, which resolves to nothing. The rename could not be made in place -- the committed handoff content-binds v3's exact bytes -- so it is versioned instead (honua-io/honua-sdk-js#1338). v3 stays byte-valid until honua-site cuts over."
}
