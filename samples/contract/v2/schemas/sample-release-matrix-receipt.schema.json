{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/sample-release-matrix-receipt.v1.schema.json",
  "title": "Honua SDK sample release-matrix browser receipt v1",
  "description": "Persisted per-engine outcome of the release-only cross-browser smoke (Chromium, Firefox, WebKit) for one golden sample. Unlike honua.sdk.sample-gate-receipt.v1 this receipt records failures too: a failing release-matrix run must still be sealed so the golden qualification becomes stale rather than silently keeping a Chromium-only claim.",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "sampleId",
    "lane",
    "status",
    "sdkMode",
    "sourceRevision",
    "sourceDigest",
    "matrix",
    "command",
    "run",
    "report",
    "producer",
    "observedAt",
    "expiresAt"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.sample-release-matrix-receipt.v1" },
    "schemaVersion": { "const": 1 },
    "sampleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "lane": { "const": "release-matrix-browser" },
    "status": {
      "description": "Aggregate outcome of the sealed run. `failed` is a first-class, publishable outcome.",
      "enum": ["passed", "failed"]
    },
    "sdkMode": { "const": "source" },
    "sourceRevision": {
      "description": "Named source commit the matrix executed against, whose evidence-neutral tree matched sourceDigest at seal time.",
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceDigest": {
      "description": "SHA-256 binding for the evidence-neutral source index and revision tree, produced by scripts/sample-gate-receipt.mjs.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "matrix": {
      "type": "object",
      "required": ["envName", "envValue", "playwrightConfig", "playwrightVersion", "engines"],
      "properties": {
        "envName": { "const": "HONUA_FIRST_MAP_RELEASE_MATRIX" },
        "envValue": { "const": "true" },
        "playwrightConfig": { "const": "playwright.first-map.config.mjs" },
        "playwrightVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$" },
        "engines": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/engine" }
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$" }
        }
      },
      "additionalProperties": false
    },
    "run": {
      "description": "Workflow run identity of the release smoke that observed these outcomes.",
      "type": "object",
      "required": ["repository", "workflow", "runId", "runAttempt", "event", "ref", "commit"],
      "properties": {
        "repository": { "const": "honua-io/honua-sdk-js" },
        "workflow": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "event": { "enum": ["release", "workflow_dispatch"] },
        "ref": { "type": "string", "pattern": "^refs/(?:heads|tags)/[A-Za-z0-9._/-]+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "report": {
      "description": "Integrity binding for the raw Playwright JSON report the engines were read from. The report itself is retained as the release smoke's workflow artifact; only its digest is sealed here, so this receipt stays a single bounded file inside samples/evidence.",
      "type": "object",
      "required": ["kind", "bytes", "sha256", "workflowArtifactName"],
      "properties": {
        "kind": { "const": "playwright-release-matrix-report" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "workflowArtifactName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": { "const": "honua-sdk-release-matrix-receipt" },
        "version": { "const": 1 },
        "path": { "const": "scripts/seal-release-matrix-receipt.mjs" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "engine": {
      "type": "object",
      "required": ["name", "browserName", "headless", "status", "tests", "failed", "durationMs"],
      "properties": {
        "name": { "enum": ["chromium", "firefox", "webkit"] },
        "browserName": { "enum": ["chromium", "firefox", "webkit"] },
        "headless": {
          "description": "True headless Firefox has no compositor and therefore no WebGL, so the release matrix runs it headed under a virtual display (see honua-io/honua-sdk-js#687).",
          "type": "boolean"
        },
        "status": { "enum": ["passed", "failed", "timedOut", "skipped", "interrupted"] },
        "tests": { "type": "integer", "minimum": 1 },
        "failed": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
