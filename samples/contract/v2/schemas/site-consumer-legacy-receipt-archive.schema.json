{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.honua.io/sdk/site-consumer-legacy-receipt-archive.schema.json",
  "title": "Honua site consumer legacy visual receipt archive",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "handoff", "visualEvidence", "producers", "entries"],
  "properties": {
    "$schema": {
      "const": "../schemas/site-consumer-legacy-receipt-archive.schema.json"
    },
    "format": {
      "const": "honua.site.sdk-sample-legacy-receipt-archive.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "schemaVersion", "sha256"],
      "properties": {
        "path": {
          "const": "samples/contract/v2/consumer-fixtures/honua-site-consumer-handoff.legacy.v1.json"
        },
        "format": { "const": "honua.site.sdk-sample-consumer-handoff.v1" },
        "schemaVersion": { "const": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "visualEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "samples/dist/golden-journey-visual-evidence.v1.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "producers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRevision", "sourcePath", "bytes", "sha256", "contentBase64"],
        "properties": {
          "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "sourcePath": { "const": "scripts/sample-runner.mjs" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "contentBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1398104,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sampleId",
          "gate",
          "sourceRevision",
          "sourceDigest",
          "sourcePath",
          "bytes",
          "sha256",
          "contentBase64"
        ],
        "properties": {
          "sampleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "gate": {
            "enum": [
              "packed-build",
              "browser",
              "accessibility",
              "console",
              "responsive",
              "screenshot",
              "performance",
              "fixture",
              "live"
            ]
          },
          "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "sourceDigest": { "$ref": "#/$defs/sha256" },
          "sourcePath": {
            "type": "string",
            "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/receipts/[a-z-]+\\.v1\\.json$"
          },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "contentBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1398104,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
