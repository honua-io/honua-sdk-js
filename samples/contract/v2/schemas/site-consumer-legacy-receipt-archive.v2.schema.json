{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.honua.io/sdk/site-consumer-legacy-receipt-archive.v2.schema.json",
  "title": "Honua site consumer self-contained legacy visual receipt archive",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "handoff", "visualEvidence", "artifacts", "producers", "entries"],
  "properties": {
    "$schema": {
      "const": "../schemas/site-consumer-legacy-receipt-archive.v2.schema.json"
    },
    "format": {
      "const": "honua.site.sdk-sample-legacy-receipt-archive.v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "schemaVersion", "sha256"],
      "properties": {
        "path": { "const": "samples/dist/honua-site-consumer-handoff.v1.json" },
        "format": { "const": "honua.site.sdk-sample-consumer-handoff.v1" },
        "schemaVersion": { "const": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "visualEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "samples/dist/golden-journey-visual-evidence.v1.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "referencedBytes", "blobCount", "decodedBytes", "inventorySha256", "files", "blobs"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 160 },
        "referencedBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "blobCount": { "type": "integer", "minimum": 1, "maximum": 128 },
        "decodedBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "inventorySha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 160,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/runs/[a-f0-9-]{36}/artifacts/[A-Za-z0-9._/-]+|scripts/[a-z0-9-]+\\.mjs|examples/[a-z0-9]+(?:-[a-z0-9]+)*/[A-Za-z0-9._/-]+\\.mjs)$"
              },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "blobs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bytes", "sha256", "encoding", "encodedBytes", "contentBase64"],
            "properties": {
              "bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "encoding": { "const": "gzip-base64" },
              "encodedBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
              "contentBase64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 5592408,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              }
            }
          }
        }
      }
    },
    "producers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRevision", "sourcePath", "bytes", "sha256", "contentBase64"],
        "properties": {
          "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "sourcePath": { "const": "scripts/sample-runner.mjs" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "contentBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1398104,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sampleId",
          "gate",
          "sourceRevision",
          "sourceDigest",
          "sourcePath",
          "bytes",
          "sha256",
          "contentBase64"
        ],
        "properties": {
          "sampleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "gate": {
            "enum": [
              "packed-build",
              "browser",
              "accessibility",
              "console",
              "responsive",
              "screenshot",
              "performance",
              "fixture",
              "live"
            ]
          },
          "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "sourceDigest": { "$ref": "#/$defs/sha256" },
          "sourcePath": {
            "type": "string",
            "pattern": "^samples/evidence/[a-z0-9]+(?:-[a-z0-9]+)*/receipts/[a-z-]+\\.v1\\.json$"
          },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "contentBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1398104,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
