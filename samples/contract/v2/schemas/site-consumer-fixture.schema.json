{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/site-sample-consumer-fixture.v3.schema.json",
  "title": "Honua site SDK sample consumer fixture v3",
  "type": "object",
  "required": ["format", "schemaVersion", "accepts", "input", "assertions", "filterCases", "interaction"],
  "properties": {
    "format": { "const": "honua.site.sdk-sample-consumer-fixture.v3" },
    "schemaVersion": { "const": 3 },
    "accepts": {
      "type": "object",
      "required": [
        "handoffFormat",
        "handoffSchemaVersion",
        "siteProjectionFormat",
        "capabilityMatrixFormat",
        "visualEvidenceFormat"
      ],
      "properties": {
        "handoffFormat": { "const": "honua.site.sdk-sample-consumer-handoff.v1" },
        "handoffSchemaVersion": { "const": 1 },
        "siteProjectionFormat": { "const": "honua.site.sdk-sample-projection.v2" },
        "capabilityMatrixFormat": { "const": "honua.site.sdk-capability-sample-matrix.v1" },
        "visualEvidenceFormat": { "const": "honua.sdk.golden-journey-visual-evidence.v1" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["path", "schemaPath", "format", "schemaVersion", "bytes", "sha256"],
      "properties": {
        "path": { "const": "samples/dist/honua-site-consumer-handoff.v1.json" },
        "schemaPath": { "const": "samples/contract/v2/schemas/site-consumer-handoff.schema.json" },
        "format": { "const": "honua.site.sdk-sample-consumer-handoff.v1" },
        "schemaVersion": { "const": 1 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "type": "string", "maxLength": 64, "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "assertions": {
      "type": "object",
      "required": [
        "cardCount",
        "qualifiedJourneyCount",
        "canonicalRouteCount",
        "legacyRouteCount",
        "gapCount",
        "everyQualifiedTrackHandedOff",
        "honestZeroQualificationAllowed",
        "allLegacyRoutesResolved",
        "externalListingsCanonicalOnly",
        "sourceImplementationDuplicated",
        "taskCapabilityProtocolFiltersRequired",
        "accessibleKeyboardContractRequired",
        "desktopMobileResponsiveContractRequired",
        "incidentOperationsRealtimeRequired"
      ],
      "properties": {
        "cardCount": { "type": "integer", "minimum": 1, "maximum": 512 },
        "qualifiedJourneyCount": { "type": "integer", "minimum": 0, "maximum": 512 },
        "canonicalRouteCount": { "type": "integer", "minimum": 1, "maximum": 512 },
        "legacyRouteCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "gapCount": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "everyQualifiedTrackHandedOff": { "const": true },
        "honestZeroQualificationAllowed": { "const": true },
        "allLegacyRoutesResolved": { "const": true },
        "externalListingsCanonicalOnly": { "const": true },
        "sourceImplementationDuplicated": { "const": false },
        "taskCapabilityProtocolFiltersRequired": { "const": true },
        "accessibleKeyboardContractRequired": { "const": true },
        "desktopMobileResponsiveContractRequired": { "const": true },
        "incidentOperationsRealtimeRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "filterCases": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/allCase" },
        { "$ref": "#/$defs/taskCase" },
        { "$ref": "#/$defs/capabilityCase" },
        { "$ref": "#/$defs/protocolCase" },
        { "$ref": "#/$defs/combinedCase" },
        { "$ref": "#/$defs/textCase" },
        { "$ref": "#/$defs/zeroCase" }
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "interaction": {
      "type": "object",
      "required": ["filters", "accessibility", "keyboard", "responsive"],
      "properties": {
        "filters": {
          "type": "object",
          "required": [
            "dimensions",
            "textNormalization",
            "textTerms",
            "facetMatching",
            "zeroResultsVisible",
            "clearControlRequired"
          ],
          "properties": {
            "dimensions": {
              "const": [
                "task",
                "capability",
                "protocol",
                "renderer",
                "data-mode",
                "auth-mode",
                "support-tier",
                "lifecycle-state",
                "qualification-state"
              ]
            },
            "textNormalization": { "const": "NFKC-lowercase-trim-collapse-whitespace" },
            "textTerms": { "const": "and" },
            "facetMatching": { "const": "exact-and" },
            "zeroResultsVisible": { "const": true },
            "clearControlRequired": { "const": true }
          },
          "additionalProperties": false
        },
        "accessibility": {
          "type": "object",
          "required": [
            "filterRegionRole",
            "filterRegionAccessibleNameRequired",
            "nativeControlLabelsRequired",
            "resultsRole",
            "resultsAriaLive",
            "resultsAriaAtomic",
            "cardHeadingsRequired",
            "screenshotAlternativeTextRequired",
            "lifecycleStatusVisible",
            "focusIndicatorRequired"
          ],
          "properties": {
            "filterRegionRole": { "const": "search" },
            "filterRegionAccessibleNameRequired": { "const": true },
            "nativeControlLabelsRequired": { "const": true },
            "resultsRole": { "const": "status" },
            "resultsAriaLive": { "const": "polite" },
            "resultsAriaAtomic": { "const": true },
            "cardHeadingsRequired": { "const": true },
            "screenshotAlternativeTextRequired": { "const": true },
            "lifecycleStatusVisible": { "const": true },
            "focusIndicatorRequired": { "const": true }
          },
          "additionalProperties": false
        },
        "keyboard": {
          "type": "object",
          "required": [
            "navigation",
            "controlOrder",
            "activationKeys",
            "clearFiltersControl",
            "focusAfterClear",
            "noKeyboardTrap"
          ],
          "properties": {
            "navigation": { "const": "native-tab-order" },
            "controlOrder": {
              "const": [
                "task-search",
                "capability-filter",
                "protocol-filter",
                "additional-filters",
                "clear-filters",
                "sample-cards"
              ]
            },
            "activationKeys": { "const": ["Enter", "Space"] },
            "clearFiltersControl": { "const": "button" },
            "focusAfterClear": { "const": "task-search" },
            "noKeyboardTrap": { "const": true }
          },
          "additionalProperties": false
        },
        "responsive": {
          "type": "object",
          "required": [
            "requiredViewports",
            "desktopControls",
            "mobileControls",
            "minimumTouchTargetCssPixels",
            "horizontalPageOverflowForbidden",
            "contentLossForbidden"
          ],
          "properties": {
            "requiredViewports": {
              "type": "array",
              "prefixItems": [
                { "$ref": "#/$defs/desktopViewport" },
                { "$ref": "#/$defs/mobileViewport" }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "desktopControls": { "const": "multi-column" },
            "mobileControls": { "const": "single-column" },
            "minimumTouchTargetCssPixels": { "const": 44 },
            "horizontalPageOverflowForbidden": { "const": true },
            "contentLossForbidden": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 512 },
        "task": { "type": "string", "minLength": 1, "maxLength": 512 },
        "capability": { "type": "string", "minLength": 1, "maxLength": 512 },
        "protocol": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "expectedSampleIds": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "filterCase": {
      "type": "object",
      "required": ["id", "filters", "expectedSampleIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "filters": { "$ref": "#/$defs/stringMap" },
        "expectedSampleIds": { "$ref": "#/$defs/expectedSampleIds" }
      },
      "additionalProperties": false
    },
    "allCase": {
      "allOf": [
        { "$ref": "#/$defs/filterCase" },
        { "properties": { "id": { "const": "all-public-cards" }, "filters": { "const": {} } } }
      ]
    },
    "taskCase": {
      "allOf": [
        { "$ref": "#/$defs/filterCase" },
        { "properties": { "id": { "const": "task" }, "filters": { "required": ["task"] } } }
      ]
    },
    "capabilityCase": {
      "allOf": [
        { "$ref": "#/$defs/filterCase" },
        { "properties": { "id": { "const": "capability" }, "filters": { "required": ["capability"] } } }
      ]
    },
    "protocolCase": {
      "allOf": [
        { "$ref": "#/$defs/filterCase" },
        { "properties": { "id": { "const": "protocol" }, "filters": { "required": ["protocol"] } } }
      ]
    },
    "combinedCase": {
      "allOf": [
        { "$ref": "#/$defs/filterCase" },
        {
          "properties": {
            "id": { "const": "combined" },
            "filters": { "required": ["task", "capability", "protocol"] }
          }
        }
      ]
    },
    "textCase": {
      "allOf": [
        { "$ref": "#/$defs/filterCase" },
        { "properties": { "id": { "const": "text" }, "filters": { "required": ["text"] } } }
      ]
    },
    "zeroCase": {
      "allOf": [
        { "$ref": "#/$defs/filterCase" },
        {
          "properties": {
            "id": { "const": "zero-results" },
            "filters": { "required": ["text"] },
            "expectedSampleIds": { "const": [] }
          }
        }
      ]
    },
    "desktopViewport": {
      "type": "object",
      "required": ["id", "viewport"],
      "properties": {
        "id": { "const": "desktop" },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": { "width": { "const": 1280 }, "height": { "const": 720 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mobileViewport": {
      "type": "object",
      "required": ["id", "viewport"],
      "properties": {
        "id": { "const": "mobile" },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": { "width": { "const": 390 }, "height": { "const": 844 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
