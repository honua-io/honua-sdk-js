{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sample-fixture-pack-v1.json",
  "title": "Honua deterministic sample fixture pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixturePackVersion", "identity", "schema", "provenance", "license", "freshness", "integrity"],
  "properties": {
    "fixturePackVersion": { "const": "honua.fixture-pack/v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "revision": { "const": "v1" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols",
        "geometryType",
        "authorityCrs",
        "coordinateEncoding",
        "extent",
        "featureCount",
        "files"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "honua-capabilities-v1",
              "esri-geoservices-feature-server",
              "ogc-api-features-1.0",
              "server-sent-events",
              "honua-realtime-feature-events"
            ]
          }
        },
        "geometryType": { "enum": ["Point", "Polygon"] },
        "authorityCrs": { "enum": ["EPSG:4326", "OGC:CRS84"] },
        "coordinateEncoding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "axes", "order"],
          "properties": {
            "format": { "enum": ["Esri JSON", "GeoJSON", "GeoJSON-compatible positions"] },
            "axes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
              }
            },
            "order": { "const": "xy" }
          }
        },
        "projections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol", "crs", "coordinateEncoding"],
            "properties": {
              "protocol": {
                "enum": [
                  "honua-capabilities-v1",
                  "esri-geoservices-feature-server",
                  "ogc-api-features-1.0",
                  "server-sent-events",
                  "honua-realtime-feature-events"
                ]
              },
              "crs": { "enum": ["EPSG:4326", "OGC:CRS84"] },
              "coordinateEncoding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["format", "axes", "order"],
                "properties": {
                  "format": { "enum": ["Esri JSON", "GeoJSON", "GeoJSON-compatible positions"] },
                  "axes": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
                    }
                  },
                  "order": { "const": "xy" }
                }
              }
            }
          }
        },
        "extent": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "featureCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "editableRecordId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "eventCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "eventExtentPolicy": { "enum": ["within-declared-extent"] },
        "files": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "retrievedAt", "transformation", "refreshCommand"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "transformation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "refreshCommand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "attribution", "redistributionAllowed"],
      "properties": {
        "spdx": { "const": "Apache-2.0" },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "redistributionAllowed": { "const": true }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "asOf", "refreshAfterDays"],
      "properties": {
        "policy": { "const": "immutable" },
        "asOf": { "type": "string", "format": "date-time" },
        "refreshAfterDays": { "type": "null" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "metadataFingerprint", "metadataComponents", "files"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "metadataFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "metadataComponents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["license", "provenance"],
          "properties": {
            "license": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "provenance": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
