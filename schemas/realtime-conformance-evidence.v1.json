{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/realtime-conformance-evidence.v1.schema.json",
  "title": "Honua JavaScript SDK realtime cross-transport conformance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "lane",
    "generatedAt",
    "sdk",
    "server",
    "corpus",
    "summary",
    "transports"
  ],
  "properties": {
    "format": { "const": "honua.sdk.realtime-conformance-evidence.v1" },
    "schemaVersion": { "const": 1 },
    "lane": { "enum": ["fixture", "live"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "revision"],
      "properties": {
        "package": { "const": "@honua/sdk-js" },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "revisionSource", "capabilities"],
      "properties": {
        "version": { "type": ["string", "null"], "minLength": 1 },
        "revision": {
          "type": ["string", "null"],
          "pattern": "^(?:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
        },
        "revisionSource": {
          "description": "Which document bound this evidence to a deployment: the realtime capability response, the public capability manifest, or the fixture corpus digest. Null when no immutable revision was observed.",
          "enum": ["capabilities", "manifest", "fixture", null]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sse", "websocket", "odata"],
          "properties": {
            "sse": { "type": "boolean" },
            "websocket": { "type": "boolean" },
            "odata": { "type": "boolean" }
          }
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "sha256"],
      "properties": {
        "kind": { "const": "honua.realtime-cross-transport-conformance" },
        "version": { "const": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "transportCount",
        "scenarioCount",
        "executionCount",
        "executed",
        "unsupported",
        "degraded",
        "failed"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "transportCount": { "type": "integer", "const": 3 },
        "scenarioCount": { "type": "integer", "minimum": 0 },
        "executionCount": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "degraded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "conformance": { "$ref": "#/$defs/conformanceRun" },
    "transports": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/transport" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "summary": {
            "properties": {
              "executed": { "minimum": 1 }
            },
            "required": ["executed"]
          }
        }
      },
      "then": {
        "properties": {
          "server": {
            "properties": {
              "revision": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
              },
              "revisionSource": { "enum": ["capabilities", "manifest", "fixture"] }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "status": { "enum": ["executed", "unsupported", "degraded", "failed"] },
    "conformanceRun": {
      "description": "Outcome of the controlled-conformance run the live lane drove against honua-server's dedicated conformance source (honua-server#3038). Present on live documents only. Never carries the per-run ownership token.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "runId",
        "serviceId",
        "layerId",
        "deploymentRevision",
        "mutations",
        "baseline"
      ],
      "properties": {
        "status": { "enum": ["executed", "skipped", "degraded", "failed"] },
        "reason": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "runId": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-fA-F]{32}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "serviceId": { "type": ["string", "null"], "minLength": 1 },
        "layerId": { "type": ["integer", "null"], "minimum": 0 },
        "deploymentRevision": { "type": ["string", "null"], "minLength": 1 },
        "mutations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["insert", "touch"],
          "properties": {
            "insert": { "type": "integer", "minimum": 0, "maximum": 1 },
            "touch": { "type": "integer", "minimum": 0 }
          }
        },
        "baseline": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "runId",
            "deletedRecords",
            "leaseDigest",
            "cleanupDigest",
            "baselineRecordCount",
            "baselineRestored",
            "digestVerified"
          ],
          "properties": {
            "runId": { "type": "string", "minLength": 1 },
            "deletedRecords": { "type": "integer", "minimum": 0 },
            "leaseDigest": { "type": "string", "pattern": "^(?:sha256:)?[a-f0-9]{64}$" },
            "cleanupDigest": { "type": "string", "pattern": "^(?:sha256:)?[a-f0-9]{64}$" },
            "baselineRecordCount": { "type": "integer", "minimum": 0 },
            "baselineRestored": { "type": "boolean" },
            "digestVerified": { "type": "boolean" }
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "scenario"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "message": { "type": "string", "minLength": 1 },
        "scenario": { "type": ["string", "null"] }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "result": { "enum": ["passed", "failed"] }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "freshness",
        "advertised",
        "status",
        "scenarioCounts",
        "scenarios",
        "diagnostics"
      ],
      "properties": {
        "id": { "enum": ["sse", "websocket", "odata"] },
        "freshness": { "enum": ["push", "poll"] },
        "advertised": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "acceptedState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventCount", "historySha256", "finalStateSha256"],
          "properties": {
            "eventCount": { "type": "integer", "minimum": 2 },
            "historySha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "finalStateSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "baselineState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventCount", "historySha256", "finalStateSha256"],
          "properties": {
            "eventCount": { "type": "integer", "minimum": 1 },
            "historySha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "finalStateSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "scenarioCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        },
        "scenarios": {
          "type": "array",
          "items": { "$ref": "#/$defs/scenarioResult" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    }
  }
}
