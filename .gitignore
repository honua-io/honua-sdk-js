dist/
# samples/dist is a committed contract projection directory, not build output.
# The `dist/` rule above matches it at any depth, which silently drops a newly
# generated artifact from `git add` while the older tracked ones keep working.
!samples/dist/
mcp/dist/
coverage/
# Test and certification output; evidence goes to CI artifacts or release assets.
test-results/
.tmp/
node_modules
*.tgz
!samples/evidence/**/*.tgz
a.out
.artifacts/
.qualification/

# Agent worktrees created by Claude Code; never part of a commit.
.claude/worktrees/
