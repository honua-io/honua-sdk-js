{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    {
      "type": "node-workspace",
      "updatePeerDependencies": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "component": "js-sdk",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": true,
      "extra-files": [
        {
          "type": "json",
          "path": "samples/contract/v1/fixtures/sample-evidence.fixture.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "samples/contract/v1/fixtures/sample-evidence.live.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "samples/contract/v1/fixtures/sample-evidence.skipped.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "examples/ai-spatial-app-builder/evidence/live-skipped.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "examples/realtime-incident-dashboard/evidence/live-skipped.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "examples/spatial-analytics-workbench/evidence/live-skipped.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "samples/evidence/imagery-cog-quickstart/live.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "samples/evidence/maplibre-quickstart/live.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "samples/evidence/migration-workbench/live.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "samples/evidence/service-explorer/live.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "bench/cross-sdk/corpus.json",
          "jsonpath": "$.references[0].package.version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "json",
          "path": "support/projections/sdk-support.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "config/sdk-coverage.v1.json",
          "jsonpath": "$.sdk.version"
        },
        {
          "type": "json",
          "path": "config/protocol-certification.v1.json",
          "jsonpath": "$.clientVersion"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "section": "Miscellaneous", "hidden": true }
      ]
    },
    "mcp": {
      "release-type": "node",
      "component": "mcp-server",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "section": "Miscellaneous", "hidden": true }
      ]
    },
    "packages/create-honua-app": {
      "release-type": "node",
      "component": "create-honua-app",
      "tag-separator": "-",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "section": "Miscellaneous", "hidden": true }
      ]
    }
  }
}
