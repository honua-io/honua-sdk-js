{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/capability-crosswalk.v1.schema.json",
  "title": "Honua JavaScript SDK sample-capability to canonical capability-key crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "source", "vocabulary", "trackingIssue", "crosswalk"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.capability-crosswalk.v1" },
    "schemaVersion": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "vocabulary": { "type": "string", "minLength": 1 },
    "trackingIssue": { "type": "string", "minLength": 1 },
    "crosswalk": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["capabilityKeys"],
          "properties": {
            "capabilityKeys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$" }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["internalOnly", "reason"],
          "properties": {
            "internalOnly": { "const": true },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
