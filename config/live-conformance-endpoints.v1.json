{
  "$schema": "./live-conformance-endpoints.schema.json",
  "format": "honua.sdk.live-conformance-endpoints.v1",
  "schemaVersion": 1,
  "revision": "2026-07-25",
  "manifestEvidenceId": "live-conformance",
  "artifact": {
    "format": "honua.sdk.live-conformance-evidence.v1",
    "schema": "schemas/live-conformance-evidence.v1.json",
    "defaultPath": "test-results/live-conformance-evidence.json"
  },
  "defaults": {
    "owner": "honua-io/honua-sdk-js maintainers",
    "authMode": "anonymous",
    "reviewCadenceDays": 90
  },
  "budgets": {
    "runTimeoutMs": 300000,
    "targetTimeoutMs": 90000,
    "requestTimeoutMs": 20000,
    "maxRequestsPerTarget": 16,
    "maxResponseBytes": 2097152,
    "maxTotalResponseBytes": 12582912,
    "maxRetriesPerRequest": 1,
    "maxPageSize": 1
  },
  "targets": [
    {
      "id": "esri-sampleserver6-citizen-requests",
      "protocol": "geoservices-feature-service",
      "endpoint": "https://sampleserver6.arcgisonline.com/arcgis/rest/services/LocalGovernment/CitizenRequests/FeatureServer/0",
      "provider": "Esri ArcGIS sample server 6",
      "attribution": "Esri public sample services.",
      "reliability": "vendor-demo",
      "owner": "honua-io/honua-sdk-js maintainers",
      "reviewedAt": "2026-07-25",
      "reviewExpiresAt": "2026-10-23",
      "sourceId": "0",
      "journey": "query",
      "expect": {
        "capabilities": ["query", "queryExtent", "queryObjectIds", "stream"],
        "conformanceEvidence": "service-metadata-operations",
        "minItemCount": 1,
        "geometry": true
      },
      "notes": "Same anonymous FeatureServer layer the Service Explorer public-live producer pins; proves GeoServices layer metadata parsing plus a bounded resultRecordCount=1 query through Source.query."
    },
    {
      "id": "pygeoapi-demo-lakes",
      "protocol": "ogc-features",
      "endpoint": "https://demo.pygeoapi.io/master",
      "provider": "pygeoapi demo deployment",
      "attribution": "pygeoapi development team.",
      "reliability": "community-demo",
      "owner": "honua-io/honua-sdk-js maintainers",
      "reviewedAt": "2026-07-25",
      "reviewExpiresAt": "2026-10-23",
      "discovery": { "collectionId": "lakes" },
      "sourceId": "lakes",
      "journey": "query",
      "expect": {
        "capabilities": ["query"],
        "conformanceEvidence": "ogc-features-conformance-classes",
        "conformanceClasses": [
          "http://www.opengis.net/spec/ogcapi-features-1/1.0/conf/core",
          "http://www.opengis.net/spec/ogcapi-features-1/1.0/conf/geojson"
        ],
        "minItemCount": 1,
        "geometry": true
      },
      "notes": "Recorded landing/conformance/collection fixtures for this deployment already back test/contract/ogc-features-backend-agnostic.test.ts; the live lane re-proves landing-link discovery against the same server."
    },
    {
      "id": "ldproxy-demo-vineyards",
      "protocol": "ogc-features",
      "endpoint": "https://demo.ldproxy.net/vineyards",
      "provider": "ldproxy vineyards demo",
      "attribution": "Landwirtschaftskammer RLP (dl-de/by-2-0) via the interactive instruments ldproxy demo.",
      "reliability": "community-demo",
      "owner": "honua-io/honua-sdk-js maintainers",
      "reviewedAt": "2026-07-25",
      "reviewExpiresAt": "2026-10-23",
      "discovery": { "collectionId": "vineyards" },
      "sourceId": "vineyards",
      "journey": "query",
      "expect": {
        "capabilities": ["query"],
        "conformanceEvidence": "ogc-features-conformance-classes",
        "conformanceClasses": ["http://www.opengis.net/spec/ogcapi-features-1/1.0/conf/core"],
        "minItemCount": 1,
        "geometry": true
      },
      "notes": "Second, independently implemented OGC API Features server so one vendor's landing-page shape cannot pass for the standard; fixtures live in test/fixtures/backend-agnostic/ldproxy."
    },
    {
      "id": "earth-search-sentinel-2-l2a",
      "protocol": "stac",
      "endpoint": "https://earth-search.aws.element84.com/v1",
      "provider": "Element 84 Earth Search",
      "attribution": "Element 84 Earth Search over AWS-hosted Sentinel-2 L2A.",
      "reliability": "cloud-reference",
      "owner": "honua-io/honua-sdk-js maintainers",
      "reviewedAt": "2026-07-25",
      "reviewExpiresAt": "2026-10-23",
      "discovery": { "collectionId": "sentinel-2-l2a" },
      "sourceId": "sentinel-2-l2a",
      "journey": "query",
      "expect": {
        "capabilities": ["query", "queryObjectIds", "stream"],
        "conformanceEvidence": "stac-landing-conformance-classes",
        "conformanceClasses": [
          "https://api.stacspec.org/v1.0.0/core",
          "https://api.stacspec.org/v1.0.0/item-search"
        ],
        "minItemCount": 1,
        "geometry": true
      },
      "notes": "STAC API item-search journey against the same root recorded in test/fixtures/backend-agnostic/earth-search-stac; item-search is the conformance class that unlocks Source.query for STAC."
    },
    {
      "id": "pdok-bag-wfs-woonplaats",
      "protocol": "wfs",
      "endpoint": "https://service.pdok.nl/lv/bag/wfs/v2_0",
      "provider": "PDOK (Kadaster, Netherlands)",
      "attribution": "Kadaster / PDOK BAG, CC BY 4.0.",
      "reliability": "national-agency",
      "owner": "honua-io/honua-sdk-js maintainers",
      "reviewedAt": "2026-07-25",
      "reviewExpiresAt": "2026-10-23",
      "discovery": { "typeName": "bag:woonplaats" },
      "sourceId": "bag:woonplaats",
      "journey": "query",
      "expect": {
        "capabilities": ["query", "stream"],
        "conformanceEvidence": "capabilities-document-operations",
        "minItemCount": 1,
        "geometry": true
      },
      "notes": "WFS 2.0 GetCapabilities plus a COUNT=1 GeoJSON GetFeature. The adapter rejects any capabilities document that is not version 2.0.0 during discovery, so no protocolVersion expectation is recorded here. The capabilities document advertises GetFeature on a different path than the service root, so this target also proves the runner's same-origin (not same-path) request policy."
    },
    {
      "id": "terrestris-osm-wms",
      "protocol": "wms",
      "endpoint": "https://ows.terrestris.de/osm/service",
      "provider": "terrestris OSM WMS",
      "attribution": "terrestris GmbH & Co. KG, data (c) OpenStreetMap contributors (ODbL).",
      "reliability": "community-demo",
      "owner": "honua-io/honua-sdk-js maintainers",
      "reviewedAt": "2026-07-25",
      "reviewExpiresAt": "2026-10-23",
      "discovery": { "typeName": "OSM-WMS" },
      "sourceId": "OSM-WMS",
      "journey": "raster-tiles",
      "expect": {
        "capabilities": ["render", "tiles"],
        "conformanceEvidence": "capabilities-document-operations",
        "protocolVersion": "1.3.0",
        "tileFormats": ["image/jpeg", "image/png"],
        "tile": { "z": 0, "x": 0, "y": 0 }
      },
      "notes": "WMS 1.3.0 capabilities parsing plus one 256x256 GetMap built by the SDK's MapLibre raster projection, so a WMS KVP serializer regression fails even though GetCapabilities still returns 200."
    },
    {
      "id": "arcgis-online-world-street-map-wmts",
      "protocol": "wmts",
      "endpoint": "https://services.arcgisonline.com/arcgis/rest/services/World_Street_Map/MapServer/WMTS",
      "provider": "Esri ArcGIS Online basemaps",
      "attribution": "Esri, HERE, Garmin, and the GIS user community.",
      "reliability": "vendor-demo",
      "owner": "honua-io/honua-sdk-js maintainers",
      "reviewedAt": "2026-07-25",
      "reviewExpiresAt": "2026-10-23",
      "discovery": { "typeName": "World_Street_Map", "styleId": "default", "tileMatrixSetId": "GoogleMapsCompatible" },
      "sourceId": "World_Street_Map",
      "journey": "raster-tiles",
      "expect": {
        "capabilities": ["tiles"],
        "conformanceEvidence": "capabilities-document-operations",
        "protocolVersion": "1.0.0",
        "tileFormats": ["image/jpeg"],
        "tile": { "z": 0, "x": 0, "y": 0 }
      },
      "notes": "WMTS 1.0.0 capabilities parsing plus one RESTful ResourceURL tile. The same MapServer root is already referenced by the repo's web-map fixtures, and this layer advertises a default style, GoogleMapsCompatible, and a standard image media type - all three of which the SDK requires before it will advertise tiles."
    },
    {
      "id": "odata-v4-northwind-customers",
      "protocol": "odata",
      "endpoint": "https://services.odata.org/V4/Northwind/Northwind.svc",
      "provider": "OASIS OData reference services",
      "attribution": "OASIS OData reference service (Northwind V4).",
      "reliability": "vendor-demo",
      "owner": "honua-io/honua-sdk-js maintainers",
      "reviewedAt": "2026-07-25",
      "reviewExpiresAt": "2026-10-23",
      "sourceId": "Customers",
      "journey": "query",
      "expect": {
        "capabilities": ["query", "queryObjectIds", "stream"],
        "conformanceEvidence": "service-metadata-operations",
        "minItemCount": 1,
        "geometry": false
      },
      "notes": "OData v4 CSDL ($metadata) parsing plus a bounded $top=1 entity-set page. The TripPin reference service recorded in test/fixtures/backend-agnostic/odata issues session-scoped 302 redirects, which this lane refuses to follow, so the redirect-free Northwind V4 root is pinned instead."
    }
  ]
}
