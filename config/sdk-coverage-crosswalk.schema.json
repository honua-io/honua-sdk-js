{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/sdk-coverage-crosswalk.v1.schema.json",
  "title": "Honua JavaScript SDK support-manifest to canonical capability-key coverage crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "source", "trackingIssue", "introductionVersions", "protocols", "supportClaims", "extras"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.sdk-coverage-crosswalk.v1" },
    "schemaVersion": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "trackingIssue": { "type": "string", "minLength": 1 },
    "introductionVersions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/mappingEntry" }
    },
    "supportClaims": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/mappingEntry" }
    },
    "extras": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/extraEntry" }
    }
  },
  "$defs": {
    "mappingEntry": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["capabilityKeys"],
          "properties": {
            "capabilityKeys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$" }
            },
            "forcePartial": { "type": "boolean" },
            "extraEvidence": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["internalOnly", "reason"],
          "properties": {
            "internalOnly": { "const": true },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "extraEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entrypoints", "sourceFiles", "evidence"],
      "properties": {
        "status": { "enum": ["covered", "partial"] },
        "note": { "type": "string", "minLength": 1 },
        "entrypoints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sourceFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "if": { "properties": { "status": { "const": "partial" } } },
      "then": { "required": ["status", "note", "entrypoints", "sourceFiles", "evidence"] }
    }
  }
}
