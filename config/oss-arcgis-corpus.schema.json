{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/oss-arcgis-corpus.v1.schema.json",
  "title": "Honua third-party open-source ArcGIS app corpus",
  "description": "Pinned, license-reviewed list of third-party open-source ArcGIS JS applications the opt-in migration readiness lane clones and analyzes. Entries are pointers only: no third-party source is vendored into this repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "revision", "guardrails", "licensePolicy", "lane", "apps"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.oss-arcgis-corpus.v1" },
    "schemaVersion": { "const": 1 },
    "revision": { "$ref": "#/$defs/date" },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noVendoredThirdPartyCode",
        "excludedFromPrCi",
        "requiresOptIn",
        "noLiveEsriServiceContact",
        "noThirdPartyDependencyInstall",
        "notes"
      ],
      "properties": {
        "noVendoredThirdPartyCode": { "const": true },
        "excludedFromPrCi": { "const": true },
        "requiresOptIn": { "const": true },
        "noLiveEsriServiceContact": { "const": true },
        "noThirdPartyDependencyInstall": { "const": true },
        "notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "licensePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedSpdxIds", "review"],
      "properties": {
        "allowedSpdxIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "Unlicense", "CC0-1.0"]
          }
        },
        "review": { "type": "string", "minLength": 1 }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optInEnvVar",
        "checkoutRoot",
        "reportRoot",
        "publishedObservationPath",
        "codemodTarget",
        "widgetGatePct"
      ],
      "properties": {
        "optInEnvVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "checkoutRoot": { "$ref": "#/$defs/relativePath" },
        "reportRoot": { "$ref": "#/$defs/relativePath" },
        "publishedObservationPath": { "$ref": "#/$defs/relativePath" },
        "codemodTarget": { "enum": ["honua-compat", "honua-maplibre", "esri-leaflet"] },
        "widgetGatePct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "apps": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!\\.\\./)[^:]*$" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "repo", "license", "provenance", "styles", "scanRoot", "evidencePaths", "notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "owner", "name", "url", "defaultBranch", "commit", "observedAt"],
          "properties": {
            "host": { "const": "github" },
            "owner": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
            "defaultBranch": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "observedAt": { "$ref": "#/$defs/date" }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdxId", "url", "holder"],
          "properties": {
            "spdxId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "holder": { "type": "string", "minLength": 1 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorKind", "author", "description"],
          "properties": {
            "authorKind": { "enum": ["government", "university", "ngo", "civic-tech", "individual", "vendor"] },
            "author": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["widget-heavy", "amd-require", "featurelayer-centric"] }
        },
        "scanRoot": { "$ref": "#/$defs/relativePath" },
        "evidencePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
