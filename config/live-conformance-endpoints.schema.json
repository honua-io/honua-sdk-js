{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/live-conformance-endpoints.v1.schema.json",
  "title": "Honua JavaScript SDK live-conformance endpoint manifest",
  "description": "Versioned, reviewed list of public reference services the scheduled live-conformance lane drives through the public SDK journeys. Every entry is anonymous, credential-free, and owner-reviewed with an explicit review expiry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "revision",
    "manifestEvidenceId",
    "artifact",
    "defaults",
    "budgets",
    "targets"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.live-conformance-endpoints.v1" },
    "schemaVersion": { "const": 1 },
    "revision": { "$ref": "#/$defs/date" },
    "manifestEvidenceId": {
      "description": "config/support-manifest.v1.json evidence id that points at this lane.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schema", "defaultPath"],
      "properties": {
        "format": { "const": "honua.sdk.live-conformance-evidence.v1" },
        "schema": { "const": "schemas/live-conformance-evidence.v1.json" },
        "defaultPath": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "authMode", "reviewCadenceDays"],
      "properties": {
        "owner": { "$ref": "#/$defs/owner" },
        "authMode": { "const": "anonymous" },
        "reviewCadenceDays": { "type": "integer", "minimum": 7, "maximum": 400 }
      }
    },
    "budgets": {
      "description": "Hard ceilings applied to every target. REQ-004: timeouts, pagination, cancellation, response size, and retries are all bounded here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runTimeoutMs",
        "targetTimeoutMs",
        "requestTimeoutMs",
        "maxRequestsPerTarget",
        "maxResponseBytes",
        "maxTotalResponseBytes",
        "maxRetriesPerRequest",
        "maxPageSize"
      ],
      "properties": {
        "runTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 900000 },
        "targetTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "maxRequestsPerTarget": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 4194304 },
        "maxTotalResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 33554432 },
        "maxRetriesPerRequest": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maxPageSize": { "type": "integer", "minimum": 1, "maximum": 25 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "owner": { "type": "string", "minLength": 3 },
    "protocol": {
      "description": "Subset of CONNECT_SOURCE_PROTOCOLS this lane drives.",
      "enum": [
        "geoservices-feature-service",
        "geoservices-map-service",
        "ogc-features",
        "ogc-tiles",
        "ogc-maps",
        "ogc-records",
        "ogc-processes",
        "stac",
        "wfs",
        "wms",
        "wmts",
        "odata"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "endpoint",
        "provider",
        "attribution",
        "reliability",
        "owner",
        "reviewedAt",
        "reviewExpiresAt",
        "journey",
        "expect",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "endpoint": {
          "description": "Credential-free HTTPS service root. Query strings, fragments, and userinfo are rejected by the runner.",
          "type": "string",
          "pattern": "^https://[a-z0-9.-]+\\.[a-z]{2,}(/[A-Za-z0-9._~:@!$&'()*+,;=-]+)*$"
        },
        "provider": { "type": "string", "minLength": 2 },
        "attribution": { "type": "string", "minLength": 2 },
        "reliability": {
          "description": "Operator class of the upstream service; sets the expectation for how loudly an outage should read.",
          "enum": ["national-agency", "cloud-reference", "vendor-demo", "community-demo"]
        },
        "owner": { "$ref": "#/$defs/owner" },
        "reviewedAt": { "$ref": "#/$defs/date" },
        "reviewExpiresAt": { "$ref": "#/$defs/date" },
        "enabled": { "type": "boolean" },
        "skip": {
          "description": "Required when enabled is false. The skip itself expires so a muted target cannot rot silently.",
          "type": "object",
          "additionalProperties": false,
          "required": ["reasonCode", "reason", "owner", "expiresAt"],
          "properties": {
            "reasonCode": {
              "enum": [
                "upstream-service-retired",
                "upstream-service-degraded",
                "upstream-policy-restriction",
                "sdk-gap-tracked"
              ]
            },
            "reason": { "type": "string", "minLength": 10 },
            "owner": { "$ref": "#/$defs/owner" },
            "expiresAt": { "$ref": "#/$defs/date" },
            "tracking": { "type": "string", "minLength": 1 }
          }
        },
        "discovery": {
          "description": "connect() discovery narrowing. Only the keys the addressed protocol accepts may appear.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "collectionId": { "type": "string", "minLength": 1 },
            "typeName": { "type": "string", "minLength": 1 },
            "styleId": { "type": "string", "minLength": 1 },
            "tileMatrixSetId": { "type": "string", "minLength": 1 }
          }
        },
        "sourceId": {
          "description": "Reviewed source identity the discovery result must retain.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "journey": {
          "description": "query = discovery + strict plan + one bounded page. raster-tiles = discovery + MapLibre raster projection + one bounded tile. ogc-tile and ogc-map exercise the raw protocol adapter. process-discovery proves the operation-only discovery boundary.",
          "enum": ["query", "raster-tiles", "ogc-tile", "ogc-map", "process-discovery"]
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities", "conformanceEvidence"],
          "properties": {
            "capabilities": {
              "description": "Capabilities discovery must resolve as effective before the operation runs.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "conformanceEvidence": {
              "description": "How operation/conformance-class evidence is collected for this protocol (REQ-002).",
              "enum": [
                "ogc-features-conformance-classes",
                "stac-landing-conformance-classes",
                "capabilities-document-operations",
                "service-metadata-operations"
              ]
            },
            "conformanceClasses": {
              "description": "Conformance classes that must remain advertised. Empty for protocols with no class vocabulary.",
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "protocolVersion": { "type": "string", "minLength": 1 },
            "minItemCount": { "type": "integer", "minimum": 0, "maximum": 25 },
            "geometry": { "type": "boolean" },
            "tileFormats": {
              "description": "Media types the raster journey accepts for the single bounded tile.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^image/[a-z0-9.+-]+$" }
            },
            "operationMediaTypes": {
              "description": "Reviewed response media types accepted from one raw OGC protocol operation.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }
            },
            "tile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["z", "x", "y"],
              "properties": {
                "tileMatrixSetId": { "type": "string", "minLength": 1 },
                "z": { "type": "integer", "minimum": 0, "maximum": 4 },
                "x": { "type": "integer", "minimum": 0, "maximum": 15 },
                "y": { "type": "integer", "minimum": 0, "maximum": 15 },
                "format": { "type": "string", "minLength": 1 }
              }
            },
            "map": {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "width", "height"],
              "properties": {
                "format": { "type": "string", "minLength": 1 },
                "width": { "type": "integer", "minimum": 1, "maximum": 1024 },
                "height": { "type": "integer", "minimum": 1, "maximum": 1024 }
              }
            },
            "processId": {
              "description": "Reviewed process identifier the operation-only discovery result must retain.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "notes": { "type": "string", "minLength": 10 }
      }
    }
  }
}
