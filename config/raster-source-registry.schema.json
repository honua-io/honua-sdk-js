{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/raster-source-registry.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.raster-source-registry.v1" },
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "identity", "client", "server", "endToEnd", "operations", "discoveryOperations", "note"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sessionKind": { "enum": ["cog", "image-server", "ogc-coverage", "wcs"] },
          "discoveryKind": { "enum": ["cog", "ogc-coverages", "wcs", "zarr", "netcdf"] },
          "deployment": { "enum": ["honua", "arcgis"] },
          "identity": { "enum": ["client-only-asset", "honua-service", "third-party-service", "server-backed-api", "server-backed-asset"] },
          "client": { "$ref": "#/$defs/maturity" },
          "server": { "oneOf": [{ "$ref": "#/$defs/maturity" }, { "const": "not-applicable" }] },
          "endToEnd": { "$ref": "#/$defs/maturity" },
          "operations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "discoveryOperations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "maturity": { "enum": ["supported", "experimental", "metadata-only", "unavailable"] }
  }
}
