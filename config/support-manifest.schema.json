{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/support-manifest.v1.schema.json",
  "title": "Honua JavaScript SDK support manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "rasterSourceRegistry",
    "sdk",
    "statusVocabulary",
    "environmentVocabulary",
    "executionModeVocabulary",
    "capabilityTiers",
    "freshnessPolicies",
    "evidence",
    "connectProtocols",
    "discoveryInventory",
    "protocolOperations",
    "operationSurfaces",
    "claimCapabilities",
    "claimOnlyProtocols",
    "consumerContracts",
    "packageLifecycle",
    "protocols",
    "supportClaims"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "honua.sdk.support-manifest.v1" },
    "schemaVersion": { "const": 1 },
    "rasterSourceRegistry": { "const": "config/raster-source-registry.v1.json" },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "releaseStatus"],
      "properties": {
        "package": { "const": "@honua/sdk-js" },
        "releaseStatus": { "$ref": "#/$defs/status" }
      }
    },
    "statusVocabulary": {
      "type": "array",
      "prefixItems": [
        { "const": "supported" },
        { "const": "beta" },
        { "const": "experimental" },
        { "const": "deprecated" },
        { "const": "unsupported" },
        { "const": "facade-required" }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "environmentVocabulary": {
      "type": "array",
      "prefixItems": [
        { "const": "build-time" },
        { "const": "client-only" },
        { "const": "honua-facade" },
        { "const": "protocol-adapter" },
        { "const": "standalone" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "executionModeVocabulary": {
      "type": "array",
      "prefixItems": [
        { "const": "client-fallback" },
        { "const": "discovery" },
        { "const": "facade" },
        { "const": "native" },
        { "const": "static" },
        { "const": "transport" }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "capabilityTiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityTier" },
      "minItems": 1
    },
    "freshnessPolicies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cadence", "maxAgeDays"],
        "properties": {
          "cadence": { "type": "string", "minLength": 1 },
          "maxAgeDays": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "connectProtocols": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "discoveryInventory": { "$ref": "#/$defs/discoveryInventory" },
    "protocolOperations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "operationSurfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/operationSurface" },
      "minItems": 1
    },
    "claimCapabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "claimOnlyProtocols": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "consumerContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCatalog", "honuaSite"],
      "properties": {
        "sampleCatalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "source", "supportTierMap", "protocols"],
          "properties": {
            "format": { "const": "honua.sdk.sample-catalog.v2" },
            "source": { "const": "samples/catalog.v2.json" },
            "supportTierMap": {
              "type": "object",
              "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/status" }, { "type": "null" }] }
            },
            "protocols": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/consumerProtocol" }
            }
          }
        },
        "honuaSite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "projectionFields", "joinKeys"],
          "properties": {
            "format": { "const": "honua.site.sdk-support.v1" },
            "projectionFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "joinKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      }
    },
    "packageLifecycle": { "$ref": "#/$defs/packageLifecycle" },
    "protocols": {
      "type": "array",
      "items": { "$ref": "#/$defs/protocol" },
      "minItems": 1
    },
    "supportClaims": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportClaim" },
      "minItems": 1
    }
  },
  "$defs": {
    "status": {
      "enum": ["supported", "beta", "experimental", "deprecated", "unsupported", "facade-required"]
    },
    "environment": {
      "enum": ["build-time", "client-only", "honua-facade", "protocol-adapter", "standalone"]
    },
    "executionMode": {
      "enum": ["client-fallback", "discovery", "facade", "native", "static", "transport"]
    },
    "capabilityTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "honuaServerRequired", "environments", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "honuaServerRequired": { "type": "boolean" },
        "environments": {
          "type": "array",
          "items": { "$ref": "#/$defs/environment" },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "serverAttach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "rationale"],
      "properties": {
        "disposition": { "enum": ["inherent", "roadmap"] },
        "issue": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[0-9]+$" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "roadmap" } }, "required": ["disposition"] },
          "then": { "required": ["issue"] },
          "else": { "not": { "required": ["issue"] } }
        }
      ]
    },
    "consumerProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolIds", "supportClaimIds", "external"],
      "properties": {
        "protocolIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "supportClaimIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "external": { "type": "boolean" }
      }
    },
    "discoveryInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "dispositionVocabulary",
        "protocols",
        "staticFormats"
      ],
      "properties": {
        "format": { "const": "honua.sdk.connect-discovery-inventory.v1" },
        "schemaVersion": { "const": 1 },
        "dispositionVocabulary": {
          "type": "array",
          "prefixItems": [
            { "const": "source-backed" },
            { "const": "operation-only" },
            { "const": "stac-classified" },
            { "const": "renderer-native" },
            { "const": "explicitly-unsupported" }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        },
        "protocols": {
          "type": "array",
          "items": { "$ref": "#/$defs/discoveryInventoryEntry" },
          "minItems": 1
        },
        "staticFormats": {
          "type": "array",
          "items": { "$ref": "#/$defs/discoveryInventoryEntry" },
          "minItems": 1
        }
      }
    },
    "discoveryInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition", "owner", "autoClassification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "disposition": {
          "enum": [
            "source-backed",
            "operation-only",
            "stac-classified",
            "renderer-native",
            "explicitly-unsupported"
          ]
        },
        "owner": { "type": "string", "minLength": 1 },
        "autoClassification": {
          "enum": [
            "structural",
            "structural-marker",
            "explicit-only",
            "stac-evidence",
            "not-applicable"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "freshnessPolicy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": { "enum": ["fixture", "integration", "live", "conformance"] },
        "path": { "type": "string", "minLength": 1 },
        "freshnessPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "packageLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceilings", "downstreamProjection", "entrypoints"],
      "properties": {
        "ceilings": { "type": "object" },
        "downstreamProjection": { "type": "object" },
        "surfaceTiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/surfaceTier" }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subpath", "status"],
            "properties": {
              "subpath": { "type": "string" },
              "status": { "enum": ["supported", "experimental", "deprecated"] },
              "apiEquivalent": { "type": "string" },
              "replacement": { "type": "string" },
              "replacementStatus": { "$ref": "#/$defs/status" },
              "introducedIn": { "type": "string" },
              "removeIn": { "type": "string" }
            }
          }
        }
      }
    },
    "surfaceTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "status", "barrel", "claim", "exports", "heldBack"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "barrel": { "type": "string", "minLength": 1 },
        "sdkForwarder": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "commitment": { "type": "string", "minLength": 1 },
        "mayStillChange": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exports": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "heldBack": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason", "exports"],
            "properties": {
              "status": { "$ref": "#/$defs/status" },
              "reason": { "type": "string", "minLength": 1 },
              "exports": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "operationClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "environment", "executionMode", "status", "evidence"],
      "properties": {
        "operations": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "environment": { "$ref": "#/$defs/environment" },
        "executionMode": { "$ref": "#/$defs/executionMode" },
        "status": { "$ref": "#/$defs/status" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "operationSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "kind", "surface", "evidence"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["canonical-source", "typed-adapter"] },
        "surface": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "defaultOperationStatus", "operationClaims", "queryFilter"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "defaultOperationStatus": { "const": "unsupported" },
        "operationClaims": {
          "type": "array",
          "items": { "$ref": "#/$defs/operationClaim" }
        },
        "queryFilter": { "$ref": "#/$defs/queryFilterSupport" }
      }
    },
    "queryFilterSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialect", "filter", "temporal", "notes"],
      "properties": {
        "dialect": { "type": "string", "minLength": 1 },
        "filter": { "enum": ["native", "attributes-only", "unsupported"] },
        "temporal": {
          "type": "array",
          "items": { "enum": ["source-dimension", "field-predicate"] },
          "uniqueItems": true
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "supportClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "operations",
        "environment",
        "executionMode",
        "status",
        "backendNeeded",
        "api",
        "notes",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "environment": { "$ref": "#/$defs/environment" },
        "executionMode": { "$ref": "#/$defs/executionMode" },
        "status": { "$ref": "#/$defs/status" },
        "backendNeeded": { "type": "string" },
        "serverAttach": { "$ref": "#/$defs/serverAttach" },
        "api": { "type": "string" },
        "notes": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
