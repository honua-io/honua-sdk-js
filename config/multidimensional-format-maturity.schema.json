{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk-js/multidimensional-format-maturity.v1.json",
  "title": "Internal NetCDF and HDF5 maturity descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "schemaVersion",
    "visibility",
    "title",
    "sourceOfTruth",
    "policy",
    "trackedFormats",
    "referenceOnlyFormats",
    "releaseBlockers",
    "curriculum"
  ],
  "properties": {
    "$schema": {
      "const": "./multidimensional-format-maturity.schema.json"
    },
    "format": {
      "const": "honua.sdk-js.internal-multidimensional-format-maturity.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "visibility": {
      "const": "internal-planning-only"
    },
    "title": {
      "type": "string",
      "minLength": 20
    },
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverRepository", "serverCommit", "reconciledAt", "references"],
      "properties": {
        "serverRepository": {
          "const": "honua-io/honua-server"
        },
        "serverCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "reconciledAt": {
          "type": "string",
          "format": "date-time"
        },
        "references": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicSdkExport",
        "runnableSample",
        "supportClaim",
        "coverageClaim",
        "browserFullFileDownload",
        "studioApi",
        "cliApi",
        "unblockRule"
      ],
      "properties": {
        "publicSdkExport": { "const": false },
        "runnableSample": { "const": false },
        "supportClaim": { "const": false },
        "coverageClaim": { "const": false },
        "browserFullFileDownload": { "const": false },
        "studioApi": { "const": false },
        "cliApi": { "const": false },
        "unblockRule": {
          "type": "string",
          "minLength": 80
        }
      }
    },
    "trackedFormats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/trackedFormat"
      }
    },
    "referenceOnlyFormats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/referenceOnlyFormat"
      }
    },
    "releaseBlockers": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/releaseBlocker"
      }
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentState", "currentAllowedContent", "currentProhibitedContent", "futureSequence"],
      "properties": {
        "currentState": {
          "const": "architecture-only"
        },
        "currentAllowedContent": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 10 }
        },
        "currentProhibitedContent": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 10 }
        },
        "futureSequence": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/curriculumPhase"
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "url", "assertion"],
      "properties": {
        "id": { "type": "string", "pattern": "^server-[a-z0-9-]+$" },
        "path": { "type": "string", "minLength": 8 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/honua-io/honua-server/blob/[a-f0-9]{40}/" },
        "assertion": { "type": "string", "minLength": 30 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "state", "statement", "evidenceRefs", "releaseBlocking"],
      "properties": {
        "surface": {
          "enum": [
            "admin-registration",
            "metadata-conversion-to-zarr",
            "versioned-variable-dimension-http",
            "bounded-subset-http",
            "worker-driver-image",
            "live-fixture",
            "live-canary",
            "sdk-adapter"
          ]
        },
        "state": {
          "enum": ["verified-source", "build-optional", "missing"]
        },
        "statement": { "type": "string", "minLength": 35 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^server-[a-z0-9-]+$" }
        },
        "releaseBlocking": { "type": "boolean" }
      }
    },
    "trackedFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role", "scopeBoundary", "evidence"],
      "properties": {
        "id": { "enum": ["netcdf4", "hdf5"] },
        "label": { "type": "string", "minLength": 4 },
        "role": { "const": "maturity-track" },
        "scopeBoundary": { "type": "string", "minLength": 60 },
        "evidence": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "referenceOnlyFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role", "statement", "evidenceRefs"],
      "properties": {
        "id": { "const": "grib" },
        "label": { "const": "GRIB / GRIB2" },
        "role": { "const": "reference-only" },
        "statement": { "type": "string", "minLength": 60 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^server-[a-z0-9-]+$" }
        }
      }
    },
    "releaseBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "appliesTo", "requirement", "evidenceNeeded"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["netcdf4", "hdf5"] }
        },
        "requirement": { "type": "string", "minLength": 40 },
        "evidenceNeeded": { "type": "string", "minLength": 40 }
      }
    },
    "curriculumPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "title", "entryCriteria", "learningOutcome"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "id": { "enum": ["inspect-metadata", "request-bounded-slice", "render-or-analyze", "publish-walkthrough"] },
        "title": { "type": "string", "minLength": 8 },
        "entryCriteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "learningOutcome": { "type": "string", "minLength": 40 }
      }
    }
  }
}
