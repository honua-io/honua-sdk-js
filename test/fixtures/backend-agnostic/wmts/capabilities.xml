<?xml version="1.0" encoding="UTF-8"?>
<Capabilities version="1.0.0"
  xmlns="http://www.opengis.net/wmts/1.0"
  xmlns:ows="http://www.opengis.net/ows/1.1"
  xmlns:xlink="http://www.w3.org/1999/xlink">
  <ows:ServiceIdentification>
    <ows:Title>Backend-Agnostic WMTS</ows:Title>
    <ows:Abstract>Deterministic discovery fixture.</ows:Abstract>
  </ows:ServiceIdentification>
  <ows:OperationsMetadata>
    <ows:Operation name="GetCapabilities">
      <ows:DCP><ows:HTTP><ows:Get xlink:href="./wmts"/></ows:HTTP></ows:DCP>
    </ows:Operation>
    <ows:Operation name="GetTile">
      <ows:DCP><ows:HTTP><ows:Get xlink:href="./kvp?tenant=public"/></ows:HTTP></ows:DCP>
    </ows:Operation>
    <ows:Operation name="GetFeatureInfo">
      <ows:DCP><ows:HTTP><ows:Get xlink:href="./feature-info?tenant=public"/></ows:HTTP></ows:DCP>
    </ows:Operation>
  </ows:OperationsMetadata>
  <Contents>
    <Layer>
      <ows:Title>Imagery</ows:Title>
      <ows:Abstract>Multi-style imagery tiles.</ows:Abstract>
      <ows:Identifier>imagery</ows:Identifier>
      <ows:WGS84BoundingBox>
        <ows:LowerCorner>-158.5 20.5</ows:LowerCorner>
        <ows:UpperCorner>-157.5 22.5</ows:UpperCorner>
      </ows:WGS84BoundingBox>
      <Style isDefault="true">
        <ows:Title>Day</ows:Title>
        <ows:Identifier>day</ows:Identifier>
        <LegendURL format="image/png" xlink:href="./legends/day.png"/>
      </Style>
      <Style isDefault="false"><ows:Title>Night</ows:Title><ows:Identifier>night</ows:Identifier></Style>
      <Format>image/png</Format>
      <Format>image/jpeg</Format>
      <InfoFormat>application/json</InfoFormat>
      <Dimension>
        <ows:Identifier>Time</ows:Identifier>
        <Default>2026-07-16T00:00:00Z</Default>
        <Current>true</Current>
        <Value>2026-07-15T00:00:00Z</Value>
        <Value>2026-07-16T00:00:00Z</Value>
      </Dimension>
      <TileMatrixSetLink><TileMatrixSet>WebMercatorQuad</TileMatrixSet></TileMatrixSetLink>
      <TileMatrixSetLink><TileMatrixSet>WorldCRS84Quad</TileMatrixSet></TileMatrixSetLink>
      <ResourceURL format="image/png" resourceType="tile"
        template="./tiles/{Style}/{TileMatrixSet}/{TileMatrix}/{TileRow}/{TileCol}.png?tenant=public"/>
      <ResourceURL format="application/json" resourceType="FeatureInfo"
        template="./info/{Style}/{TileMatrixSet}/{TileMatrix}/{TileRow}/{TileCol}/{J}/{I}.json?tenant=public"/>
    </Layer>
    <TileMatrixSet>
      <ows:Identifier>WebMercatorQuad</ows:Identifier>
      <ows:SupportedCRS>urn:ogc:def:crs:EPSG::3857</ows:SupportedCRS>
      <WellKnownScaleSet>urn:ogc:def:wkss:OGC:1.0:GoogleMapsCompatible</WellKnownScaleSet>
      <TileMatrix>
        <ows:Identifier>0</ows:Identifier>
        <ScaleDenominator>559082264.0287178</ScaleDenominator>
        <TopLeftCorner>-20037508.3427892 20037508.3427892</TopLeftCorner>
        <TileWidth>256</TileWidth><TileHeight>256</TileHeight>
        <MatrixWidth>1</MatrixWidth><MatrixHeight>1</MatrixHeight>
      </TileMatrix>
      <TileMatrix>
        <ows:Identifier>1</ows:Identifier>
        <ScaleDenominator>279541132.0143589</ScaleDenominator>
        <TopLeftCorner>-20037508.3427892 20037508.3427892</TopLeftCorner>
        <TileWidth>256</TileWidth><TileHeight>256</TileHeight>
        <MatrixWidth>2</MatrixWidth><MatrixHeight>2</MatrixHeight>
      </TileMatrix>
    </TileMatrixSet>
    <TileMatrixSet>
      <ows:Identifier>WorldCRS84Quad</ows:Identifier>
      <ows:SupportedCRS>urn:ogc:def:crs:OGC:1.3:CRS84</ows:SupportedCRS>
      <TileMatrix>
        <ows:Identifier>0</ows:Identifier>
        <ScaleDenominator>279541132.0143589</ScaleDenominator>
        <TopLeftCorner>-180 90</TopLeftCorner>
        <TileWidth>256</TileWidth><TileHeight>256</TileHeight>
        <MatrixWidth>2</MatrixWidth><MatrixHeight>1</MatrixHeight>
      </TileMatrix>
    </TileMatrixSet>
  </Contents>
</Capabilities>
