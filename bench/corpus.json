{
  "schemaVersion": 2,
  "id": "honua-sdk-js-deterministic-v2",
  "description": "Fixture-backed SDK overhead, opaque resource planning, offline reload, realtime reconnect, and million-row columnar data-plane, reduction, bounded-conversion, persistence, realtime-patch, and GeoParquet batch-producer scenarios. No network or renderer time is included.",
  "scenarios": [
    {
      "id": "stream.pagination.geometry",
      "kind": "stream-pagination",
      "featureCount": 10000,
      "pageSize": 1000,
      "pageLatencyMs": 0,
      "returnGeometry": true,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "stream.pagination.attributes-only",
      "kind": "stream-pagination",
      "featureCount": 10000,
      "pageSize": 1000,
      "pageLatencyMs": 0,
      "returnGeometry": false,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "query.resource.opaque",
      "kind": "query-resource-handle",
      "operationCount": 128,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "offline.region.reload",
      "kind": "offline-reload",
      "resourceCount": 64,
      "resourceBytes": 256,
      "reloadCycles": 16,
      "maxFreshnessAgeMs": 300000,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "realtime.cursor.reconnect",
      "kind": "realtime-reconnect",
      "eventCount": 1000,
      "replayDuplicateCount": 2,
      "maxFreshnessAgeMs": 300000,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "columnar.data-plane.million-feature",
      "kind": "columnar-data-plane",
      "featureCount": 1000000,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "columnar.aggregate.million-row",
      "kind": "columnar-aggregate",
      "inputRowCount": 1000000,
      "groupCount": 1024,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "columnar.result.bounded-window",
      "kind": "columnar-result-conversion",
      "batchRowCount": 1000000,
      "windowSize": 1000,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "columnar.batch-cache.million-row-round-trip",
      "kind": "columnar-batch-persistence",
      "rowCount": 1000000,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "columnar.patch.million-row",
      "kind": "columnar-patch",
      "rowCount": 1000000,
      "reserveRows": 2304,
      "patchOperations": 1000,
      "patchesPerSample": 8,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "columnar.producer.million-row",
      "kind": "columnar-producer",
      "rowCount": 1000000,
      "warmupRuns": 1,
      "measurementRuns": 5
    }
  ]
}
