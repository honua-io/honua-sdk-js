      "featureCount": 10000,
      "pageSize": 1000,
      "pageLatencyMs": 0,
      "returnGeometry": true,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "stream.pagination.attributes-only",
      "kind": "stream-pagination",
      "featureCount": 10000,
      "pageSize": 1000,
      "pageLatencyMs": 0,
      "returnGeometry": false,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "offline.region.reload",
      "kind": "offline-reload",
      "resourceCount": 64,
      "resourceBytes": 256,
      "reloadCycles": 16,
      "maxFreshnessAgeMs": 300000,
      "warmupRuns": 1,
      "measurementRuns": 5
    },
    {
      "id": "realtime.cursor.reconnect",
      "kind": "realtime-reconnect",
      "eventCount": 1000,
      "replayDuplicateCount": 2,
      "maxFreshnessAgeMs": 300000,
      "warmupRuns": 1,
      "measurementRuns": 5
    }
  ]
}
