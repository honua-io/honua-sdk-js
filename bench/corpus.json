{
  "schemaVersion": 2,
  "id": "honua-sdk-js-deterministic-v2",
  "description": "Fixture-backed SDK overhead, offline reload, and realtime reconnect scenarios. No network or renderer time is included.",
  "scenarios": [
    {
      "id": "stream.pagination.geometry",
