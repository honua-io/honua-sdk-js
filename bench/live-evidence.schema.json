{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/benchmark-live-evidence.v1.schema.json",
  "title": "Honua SDK live benchmark evidence",
  "type": "object",
  "required": ["format", "schemaVersion", "generatedAt", "contract", "sdk", "run", "targets"],
  "properties": {
    "format": { "const": "honua.sdk.benchmark-live-evidence.v1" },
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "contract": {
      "type": "object",
      "required": ["producerIssue", "consumerIssue"],
      "properties": {
        "producerIssue": { "const": "https://github.com/honua-io/honua-sdk-js/issues/401" },
        "consumerIssue": { "const": "https://github.com/honua-io/honua-site/issues/120" }
      },
      "additionalProperties": false
    },
    "sdk": {
      "type": "object",
      "required": ["package", "version", "gitCommit"],
      "properties": {
        "package": { "type": "string" },
        "version": { "type": "string" },
        "gitCommit": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["status", "trigger"],
      "properties": {
        "status": { "enum": ["passed", "failed", "skipped"] },
        "trigger": { "type": "string" },
        "skipReason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "provider", "endpoint", "authMode", "sampleEvidence"],
        "allOf": [
          {
            "$comment": "A skip must be typed. An untyped skip is indistinguishable from a swallowed failure, which is exactly what this lane must never publish.",
            "if": { "properties": { "status": { "const": "skipped" } }, "required": ["status"] },
            "then": { "required": ["skipReason", "skipReasonCode"] },
            "else": { "not": { "required": ["skipReasonCode"] } }
          }
        ],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "provider": { "type": "string" },
          "endpoint": { "type": "string", "format": "uri" },
          "authMode": { "enum": ["anonymous", "api-key", "bearer"] },
          "skipReason": { "type": "string" },
          "skipReasonCode": {
            "description": "Typed skip taxonomy. Only a probe that positively established the live environment cannot demonstrate the journey may skip; transport, status, timeout, and schema problems stay failed.",
            "enum": [
              "live-probes-disabled",
              "operator-requested-skip",
              "realtime-capability-probe-unavailable",
              "realtime-capability-disabled",
              "incident-demo-dataset-empty"
            ]
          },
          "error": { "type": "string" },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "endpointVersion": { "type": ["string", "null"] },
          "protocolVersion": { "type": ["string", "null"] },
          "latencyMs": { "type": "number", "minimum": 0 },
          "checks": { "type": "object" },
          "journey": {
            "type": "object",
            "required": [
              "id",
              "timeToFirstSuccessfulInteractionMs",
              "visibleOutcome",
              "console",
              "accessibility"
            ],
            "properties": {
              "id": { "type": "string" },
              "timeToFirstSuccessfulInteractionMs": { "type": "number", "minimum": 0 },
              "visibleOutcome": {
                "type": "object",
                "required": ["kind", "itemCount"],
                "properties": {
                  "kind": { "type": "string" },
                  "itemCount": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              },
              "console": {
                "type": "object",
                "required": ["applicable", "reason"],
                "properties": {
                  "applicable": { "const": false },
                  "reason": { "type": "string" }
                },
                "additionalProperties": false
              },
              "accessibility": {
                "type": "object",
                "required": ["applicable", "reason"],
                "properties": {
                  "applicable": { "const": false },
                  "reason": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "freshness": {
            "type": "object",
            "required": ["observedAt", "serverDate", "sourceDataTimestamp", "etag", "lastModified"],
            "properties": {
              "observedAt": { "type": "string", "format": "date-time" },
              "serverDate": { "type": ["string", "null"] },
              "sourceDataTimestamp": { "type": ["string", "null"] },
              "etag": { "type": ["string", "null"] },
              "lastModified": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "required": ["source", "requestedUrls"],
            "properties": {
              "source": { "type": "string" },
              "requestedUrls": {
                "type": "array",
                "items": { "type": "string", "format": "uri" }
              }
            },
            "additionalProperties": false
          },
          "realtime": {
            "type": "object",
            "required": ["snapshotAt", "cursor", "lagMs", "observationWindowMs", "reconnectOutcome"],
            "properties": {
              "snapshotAt": { "type": ["string", "null"] },
              "cursor": { "type": ["string", "null"] },
              "lagMs": { "type": ["number", "null"], "minimum": 0 },
              "observationWindowMs": { "type": "number", "minimum": 0 },
              "reconnectOutcome": {
                "description": "Machine-readable discriminator for why the journey did or did not reconnect. Each skip condition owns a distinct outcome so a consumer is never told the capability was unavailable when it was not.",
                "enum": [
                  "resumed-from-cursor-and-observed-delta",
                  "not-attempted-live-probes-disabled",
                  "not-attempted-operator-skip",
                  "not-attempted-capability-unavailable",
                  "not-attempted-demo-dataset-empty",
                  "not-attempted",
                  null
                ]
              }
            },
            "additionalProperties": false
          },
          "sampleEvidence": { "$ref": "https://honua.io/schemas/sdk/sample-evidence.v1.schema.json" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
