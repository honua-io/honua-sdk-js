{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/sdk/zarr-client-maturity.v1.schema.json",
  "title": "Honua JavaScript SDK Zarr client maturity descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "reviewedAt",
    "issue",
    "visibility",
    "sourceRefs",
    "maturity",
    "serverEvidence",
    "contractLimits",
    "evidenceGates",
    "futureApiShape",
    "externalVocabulary"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "format": { "const": "honua.sdk.zarr-client-maturity.v1" },
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "issue": { "type": "string", "const": "https://github.com/honua-io/honua-sdk-js/issues/1120" },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "internal-only" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "sourceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk", "server"],
      "properties": {
        "sdk": { "$ref": "#/$defs/sourceRef" },
        "server": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "client", "sample"],
      "properties": {
        "server": { "$ref": "#/$defs/maturityState" },
        "client": { "$ref": "#/$defs/maturityState" },
        "sample": { "$ref": "#/$defs/maturityState" }
      }
    },
    "serverEvidence": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/serverSurface" }
    },
    "contractLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versions", "codecs", "layout", "crs", "budgets"],
      "properties": {
        "versions": { "$ref": "#/$defs/stringList" },
        "codecs": { "$ref": "#/$defs/stringList" },
        "layout": { "$ref": "#/$defs/stringList" },
        "crs": { "$ref": "#/$defs/stringList" },
        "budgets": { "$ref": "#/$defs/stringList" }
      }
    },
    "evidenceGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicFixture", "liveService", "sdkPublication", "samplePublication"],
      "properties": {
        "publicFixture": { "$ref": "#/$defs/gateList" },
        "liveService": { "$ref": "#/$defs/gateList" },
        "sdkPublication": { "$ref": "#/$defs/gateList" },
        "samplePublication": { "$ref": "#/$defs/gateList" }
      }
    },
    "futureApiShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposed", "candidatePackage", "operations", "crossCutting"],
      "properties": {
        "exposed": { "const": false },
        "candidatePackage": { "type": "string", "const": "@honua/sdk-js/zarr" },
        "operations": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "responsibility"],
            "properties": {
              "id": { "enum": ["metadata", "slice", "tile"] },
              "responsibility": { "type": "string", "minLength": 1 }
            }
          }
        },
        "crossCutting": { "$ref": "#/$defs/stringList" }
      }
    },
    "externalVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalKeys", "mappingStatus", "gap", "promotionRule"],
      "properties": {
        "canonicalKeys": {
          "type": "array",
          "prefixItems": [
            { "const": "raster.multidim-coverage" },
            { "const": "serve.ogc-api-coverages" },
            { "const": "serve.wcs" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "mappingStatus": { "const": "internal-only" },
        "gap": { "type": "string", "minLength": 1 },
        "promotionRule": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^honua-io/[a-z0-9-]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "maturityState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {
          "enum": ["implementation-evidenced", "unavailable", "withheld"]
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "line", "claim"],
      "properties": {
        "repository": { "type": "string", "const": "honua-io/honua-server" },
        "path": { "type": "string", "minLength": 1, "pattern": "^(src|tests|docs)/" },
        "line": { "type": "integer", "minimum": 1 },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "serverSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "route", "evidence", "boundary"],
      "properties": {
        "id": { "enum": ["registration", "coverage", "datacube-tile", "wcs"] },
        "status": { "enum": ["integration-tested", "implementation-evidenced", "route-and-component-tested"] },
        "route": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gateList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "requirement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "status": { "const": "missing" },
          "requirement": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
