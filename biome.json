{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noSelfAssign": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noConfusingVoidType": "off",
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "overrides": [
    {
      "include": ["test/**/*.ts", "examples/kepler-analytics/src/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "files": {
    "include": [
      "src/**/*.ts",
      "test/**/*.ts",
      "bench/**/*.ts",
      "examples/**/*.ts",
      "examples/**/*.tsx",
      "examples/**/*.mjs",
      "examples/**/*.json",
      "samples/**/*.mjs",
      "samples/**/*.mts",
      "samples/**/*.json"
    ],
    "ignore": [
      "dist",
      "node_modules",
      "src/gen",
      "src/contract/generated",
      "test/fixtures",
      "examples/arcgis-source-app"
    ]
  }
}
