{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noSelfAssign": "off",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noDelete": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noConfusingVoidType": "off",
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "overrides": [
    {
      "include": ["test/**/*.ts", "examples/kepler-analytics/src/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": ["packages/create-honua-app/package.json"],
      "formatter": {
        "lineWidth": 80
      }
    }
  ],
  "files": {
    "maxSize": 4194304,
    "include": [
      "src/**/*.ts",
      "test/**/*.ts",
      "bench/**/*.ts",
      "conformance/semantic-query/**/*.mjs",
      "conformance/semantic-query/**/*.mts",
      "conformance/semantic-query/**/*.json",
      "examples/**/*.ts",
      "examples/**/*.tsx",
      "examples/**/*.mjs",
      "examples/**/*.json",
      "samples/**/*.mjs",
      "samples/**/*.mts",
      "samples/**/*.json",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "packages/**/*.mjs",
      "packages/**/*.json"
    ],
    "ignore": [
      "dist",
      "node_modules",
      "src/gen",
      "src/contract/generated",
      "src/control-plane/generated",
      "src/studio/generated",
      "src/runtime/generated",
      "test/fixtures",
      "examples/arcgis-source-app",
      "samples/contract/v2/consumer-fixtures/honua-site-consumer-legacy-receipts.v2.json"
    ]
  }
}
