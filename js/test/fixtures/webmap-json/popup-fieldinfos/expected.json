{
  "style": {
    "version": 8,
    "sources": {
      "buildings": {
        "type": "honua-feature-service",
        "url": "https://services.example.com/rest/services/Buildings/FeatureServer/0"
      }
    },
    "layers": [
      {
        "id": "buildings",
        "type": "fill",
