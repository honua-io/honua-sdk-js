{
  "//": "Repository-local typecheck for the generated sample playgrounds (scripts/sample-playgrounds.mjs, #958). A playground resolves @honua/sdk-js from the published package; this overlay points the same copied sources at the repository's SDK source so CI proves they still compile standalone without a registry install.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "types": ["vite/client", "node"],
    "paths": {
      "@honua/sdk-js": ["src/index.ts"],
      "@honua/sdk-js/agent-safety": ["src/agent-safety/index.ts"],
      "@honua/sdk-js/agent-tools": ["src/agent-tools/index.ts"],
      "@honua/sdk-js/app-workspace": ["src/app-workspace/index.ts"],
      "@honua/sdk-js/contract": ["src/contract/index.ts"],
      "@honua/sdk-js/columnar-workflow": ["src/columnar-workflow/index.ts"],
      "@honua/sdk-js/coverages": ["src/coverages/index.ts"],
      "@honua/sdk-js/exploration": ["src/exploration/index.ts"],
      "@honua/sdk-js/honua": ["src/honua.ts"],
      "@honua/sdk-js/map": ["src/map/index.ts"],
      "@honua/sdk-js/pmtiles": ["src/pmtiles/index.ts"],
      "@honua/sdk-js/query-planner": ["src/query-planner/index.ts"],
      "@honua/sdk-js/react": ["src/react/index.ts"],
      "@honua/sdk-js/runtime": ["src/runtime/index.ts"],
      "@honua/sdk-js/stac": ["src/stac/index.ts"],
      "@honua/sdk-js/style": ["src/style/index.ts"],
      "@honua/sdk-js/web-components": ["src/web-components/index.ts"]
    }
  },
  "include": ["playgrounds/*/src/**/*.ts", "playgrounds/*/src/**/*.tsx", "playgrounds/*/vite.config.ts"]
}
