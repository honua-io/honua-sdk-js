# Shared seeded Honua Cloud demo baseline.
# Browser samples still use VITE_* variables from their own .env files.
HONUA_CLOUD_DEMO_BASE_URL=https://cloud.honua.io
HONUA_CLOUD_DEMO_API_KEY=
HONUA_CLOUD_DEMO_BEARER_TOKEN=
HONUA_CLOUD_DEMO_METADATA_TTL_MS=900000
HONUA_CLOUD_DEMO_SUMMARY_FILE=test-results/cloud-demo-smoke.json

# Writable demo safeguards. Leave writes disabled unless the scheduled smoke
# lane has a reset token and a disposable seeded service.
HONUA_CLOUD_DEMO_ALLOW_WRITES=false
HONUA_CLOUD_DEMO_WRITE_TOKEN=
HONUA_CLOUD_DEMO_RESET_TOKEN=
HONUA_CLOUD_DEMO_RESET_URL=

# First Map (anonymous public endpoint; no browser credential variables).
VITE_HONUA_QUICKSTART_ENDPOINT=https://services.arcgis.com/P3ePLMYs2RVChkJx/arcgis/rest/services/2020_Census_State_Apportionment/FeatureServer/0
VITE_HONUA_QUICKSTART_PROTOCOL=geoservices-feature-service
VITE_HONUA_QUICKSTART_WHERE=NAME = 'Hawaii'
VITE_HONUA_QUICKSTART_RESULT_RECORD_COUNT=25
VITE_HONUA_QUICKSTART_BASEMAP_STYLE=https://demotiles.maplibre.org/style.json

# Service Explorer.
VITE_HONUA_SERVICE_EXPLORER_BASE_URL=https://cloud.honua.io
VITE_HONUA_SERVICE_EXPLORER_MODE=auto
VITE_HONUA_SERVICE_EXPLORER_SERVICE_ID=natural-earth
VITE_HONUA_SERVICE_EXPLORER_LAYER_ID=0
VITE_HONUA_SERVICE_EXPLORER_WHERE=1=1
VITE_HONUA_SERVICE_EXPLORER_RESULT_RECORD_COUNT=100
VITE_HONUA_SERVICE_EXPLORER_MAP_MOVE_DEBOUNCE_MS=160
VITE_HONUA_SERVICE_EXPLORER_SOURCE_ID=
VITE_HONUA_SERVICE_EXPLORER_API_KEY=
VITE_HONUA_SERVICE_EXPLORER_BEARER_TOKEN=

# 2.5D storytelling.
VITE_HONUA_25D_BASE_URL=https://cloud.honua.io
VITE_HONUA_25D_API_KEY=
VITE_HONUA_25D_ASSETS_COLLECTION=story-25d-assets
VITE_HONUA_25D_ROUTE_COLLECTION=story-25d-route
VITE_HONUA_25D_STOPS_COLLECTION=story-25d-stops
VITE_HONUA_25D_BASEMAP_STYLE=https://demotiles.maplibre.org/style.json

# kepler analytics fixture refresh.
HONUA_DEMO_BASE_URL=https://cloud.honua.io
HONUA_DEMO_API_KEY=
HONUA_DEMO_BEARER_TOKEN=
HONUA_DEMO_ENV_LABEL=seeded Honua Cloud demo
HONUA_DEMO_INCIDENTS_SERVICE_ID=ops-analytics
HONUA_DEMO_INCIDENTS_LAYER_ID=0
HONUA_DEMO_UNIT_TRACKS_SERVICE_ID=ops-analytics
HONUA_DEMO_UNIT_TRACKS_LAYER_ID=1
HONUA_DEMO_COVERAGE_ZONES_SERVICE_ID=ops-analytics
HONUA_DEMO_COVERAGE_ZONES_LAYER_ID=2

# Realtime incident dashboard. Auto prefers the deployed stream and visibly
# falls back to read-only replay. fixture-edit is only for isolated local/CI use.
VITE_HONUA_INCIDENT_TRANSPORT=auto
VITE_HONUA_INCIDENT_BASE_URL=https://demo.honua.io
VITE_HONUA_INCIDENT_CAPABILITIES_URL=https://demo.honua.io/api/v1/streaming/features/capabilities
VITE_HONUA_INCIDENT_STREAM_URL=https://demo.honua.io/api/v1/streaming/features
VITE_HONUA_INCIDENT_SOURCE_ID=maui-incidents
VITE_HONUA_INCIDENT_LAYER_ID=0

# Edit workflow live-lane contract. The current app remains fixture-first; these
# names reserve the seeded writable service wiring and scheduled smoke contract.
VITE_HONUA_EDIT_WORKFLOW_BASE_URL=https://cloud.honua.io
VITE_HONUA_EDIT_WORKFLOW_API_KEY=
VITE_HONUA_EDIT_WORKFLOW_BEARER_TOKEN=
VITE_HONUA_EDIT_WORKFLOW_SERVICE_ID=field-inspections-demo-writable
VITE_HONUA_EDIT_WORKFLOW_LAYER_ID=0
VITE_HONUA_EDIT_WORKFLOW_READONLY_SERVICE_ID=field-inspections-demo-readonly
