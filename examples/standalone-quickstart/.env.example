# Standalone quickstart — points the SDK at a PUBLIC GeoServices endpoint.
# No Honua server, no API key, no account. Copy to `.env` to override the
# defaults (which target Esri's public Living Atlas census FeatureServer).

# Any public GeoServices FeatureServer *layer* URL (.../FeatureServer/{layerId}).
VITE_STANDALONE_FEATURE_LAYER_URL=https://services.arcgis.com/P3ePLMYs2RVChkJx/arcgis/rest/services/2020_Census_State_Apportionment/FeatureServer/0

# Server-side WHERE clause.
VITE_STANDALONE_WHERE=1=1

# Comma-separated fields to request (omit for all: *).
# VITE_STANDALONE_OUT_FIELDS=NAME,STUSPS,Total_Pop_2020,Seats_2020

# Max pages the paginated query drains.
VITE_STANDALONE_MAX_PAGES=4

# MapLibre basemap style.
VITE_STANDALONE_BASEMAP_STYLE=https://demotiles.maplibre.org/style.json

# --- Another public GeoServices endpoint you can drop in (Esri sample server) ---
# VITE_STANDALONE_FEATURE_LAYER_URL=https://sampleserver6.arcgisonline.com/arcgis/rest/services/SampleWorldCities/MapServer/0
