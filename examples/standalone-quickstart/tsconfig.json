{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@honua/sdk-js": ["../../src/index.ts"],
      "@honua/sdk-js/esri-compat": ["../../src/esri-compat-entry.ts"],
      "@honua/sdk-js/honua": ["../../src/honua.ts"],
      "@honua/sdk-js/map": ["../../src/map/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
