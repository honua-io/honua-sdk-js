VITE_HONUA_SERVICE_EXPLORER_BASE_URL=https://cloud.honua.io
VITE_HONUA_SERVICE_EXPLORER_MODE=auto
VITE_HONUA_SERVICE_EXPLORER_SERVICE_ID=natural-earth
VITE_HONUA_SERVICE_EXPLORER_LAYER_ID=0
VITE_HONUA_SERVICE_EXPLORER_WHERE=1=1
VITE_HONUA_SERVICE_EXPLORER_RESULT_RECORD_COUNT=100
VITE_HONUA_SERVICE_EXPLORER_MAP_MOVE_DEBOUNCE_MS=160

# Set one credential to use cloud Honua at runtime. Without credentials,
# mode=auto falls back to the bundled service/layer fixture.
# VITE_HONUA_SERVICE_EXPLORER_API_KEY=
# VITE_HONUA_SERVICE_EXPLORER_BEARER_TOKEN=
