HONUA_BASE_URL=http://127.0.0.1:4455
HONUA_SERVICE_ID=CivicRequests
HONUA_LAYER_ID=0
HONUA_OGC_COLLECTION_ID=civic-requests

# Use one of these in a real backend deployment. The sample keeps the value
# in the Node process and never accepts browser-provided Honua credentials.
HONUA_API_KEY=
HONUA_SERVICE_ACCOUNT_TOKEN=

HONUA_NODE_BACKEND_HOST=127.0.0.1
HONUA_NODE_BACKEND_PORT=8787
HONUA_TIMEOUT_MS=5000
HONUA_RETRY_MAX_RETRIES=2
HONUA_RETRY_BASE_DELAY_MS=100
HONUA_RETRY_MAX_DELAY_MS=1000
