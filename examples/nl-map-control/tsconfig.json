{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@honua/sdk-js": ["../../src/index.ts"],
      "@honua/sdk-js/nl-map-control": ["../../src/nl-map-control/index.ts"],
      "@honua/sdk-js/agent-tools": ["../../src/agent-tools/index.ts"],
      "@honua/sdk-js/agent-safety": ["../../src/agent-safety/index.ts"],
      "@honua/sdk-js/query-planner": ["../../src/query-planner/index.ts"],
      "@honua/sdk-js/exploration": ["../../src/exploration/index.ts"],
      "@honua/sdk-js/contract": ["../../src/contract/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
