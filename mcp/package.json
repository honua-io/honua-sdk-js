{
  "name": "@honua/mcp-server",
  "version": "0.1.10-beta.0",
  "description": "Platform-free MCP server for geospatial services: expose discovery, query, and analysis over any public ArcGIS/Esri FeatureServer or OGC API endpoint to any MCP client, with no platform lock-in",
  "license": "Apache-2.0",
  "author": "Honua",
  "homepage": "https://honua-io.github.io/honua-sdk-js/",
  "bugs": {
    "url": "https://github.com/honua-io/honua-sdk-js/issues"
  },
  "keywords": [
    "gis",
    "geospatial",
    "maplibre",
    "typescript",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "arcgis",
    "ogc-api",
    "feature-service"
  ],
  "type": "module",
  "bin": {
    "honua-mcp": "dist/src/index.js",
    "honua-mcp-proxy": "dist/src/proxy.js",
    "honua-zero-to-map-release": "dist/src/release/zero-to-map-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./agent-execution": {
      "types": "./dist/src/agent-execution.d.ts",
      "default": "./dist/src/agent-execution.js"
    },
    "./nl-map-control": {
      "types": "./dist/src/nl-map-control.d.ts",
      "default": "./dist/src/nl-map-control.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean-output.mjs",
    "build": "npm run clean --silent && tsc -p tsconfig.json",
    "prepack": "npm run build --silent",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && vitest run --coverage",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "certify": "npm run build --silent && node dist/src/certification/cli.js",
    "certify:standalone": "npm run build --silent && node dist/src/certification/cli.js --target standalone",
    "certify:standalone-ogc": "npm run build --silent && node dist/src/certification/cli.js --target standalone-ogc",
    "test:certification:nl-map-control": "vitest run test/certification/nl-map-control.test.ts",
    "test:certification": "npm run build --silent && vitest run test/certification && node dist/src/certification/cli.js",
    "test:certification:admin": "vitest run test/proxy.test.ts test/certification/admin-parity.test.ts",
    "certify:admin-parity": "npm run build --silent && node dist/src/certification/admin-parity.js",
    "test:certification:artifact": "npm run build --silent && node dist/src/certification/cli.js --artifact-only",
    "test:certification:standalone": "npm run build --silent && node dist/src/certification/cli.js --target standalone",
    "test:certification:standalone-ogc": "npm run build --silent && node dist/src/certification/cli.js --target standalone-ogc",
    "eval": "npm run build --silent && node dist/src/eval/cli.js",
    "eval:offline": "npm run build --silent && node dist/src/eval/cli.js --offline",
    "eval:standalone": "npm run build --silent && node dist/src/eval/cli.js --corpus standalone --offline",
    "eval:ogc": "npm run build --silent && node dist/src/eval/cli.js --corpus ogc --offline",
    "eval:live": "npm run build --silent && node dist/src/eval/cli.js --corpus operator --artifact-only",
    "leaderboard": "node scripts/render-leaderboard.mjs",
    "test:eval": "npm run build --silent && vitest run test/eval && node dist/src/eval/cli.js --offline",
    "test:eval:artifact": "npm run build --silent && node dist/src/eval/cli.js --artifact-only",
    "release:zero-to-map": "npm run build --silent && node dist/src/release/zero-to-map-cli.js",
    "lint": "biome lint src/ test/",
    "lint:fix": "biome lint --write src/ test/",
    "format": "biome format src/ test/",
    "format:fix": "biome format --write src/ test/",
    "check": "biome check src/ test/",
    "check:fix": "biome check --write src/ test/"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.901.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "hono": "^4.12.27",
    "@hono/node-server": "^2.0.5",
    "fast-uri": "^3.1.6",
    "qs": "^6.16.0"
  },
  "peerDependencies": {
    "@honua/sdk-js": "^0.1.10-beta.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@honua/sdk-js": "file:..",
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "files": [
    "dist/src",
    "release/zero-to-map",
    "certification/geospatial-mcp-schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honua-io/honua-sdk-js.git",
    "directory": "mcp"
  }
}
