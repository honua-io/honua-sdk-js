    {
      "name": "Total_Pop_2020",
      "type": "esriFieldTypeInteger",
      "alias": "Total Population, 2020",
      "sqlType": "sqlTypeOther",
      "nullable": true,
      "editable": true,
      "domain": null,
      "defaultValue": null,
      "description": "{\"value\":\"Apportionment Population for 50 states as of April 1, 2020. Includes the resident population, as ascertained by the 24th Decennial Census under Title 13, U.S. Code, & counts of U.S. military & federal civilian employees living overseas (and their dependents living with them overseas) allocated to their home state, as reported by the employing federal agencies. Overseas count used for apportionment purposes only. Values for DC & Puerto Rico calculated by summing resident & overseas population. \",\"fieldValueType\":\"countOrAmount\"}"
    },
    {
      "name": "Seats_2020",
      "type": "esriFieldTypeInteger",
      "alias": "Seats in the U.S. House of Representatives, 2020",
      "sqlType": "sqlTypeOther",
      "nullable": true,
      "editable": true,
      "domain": null,
      "defaultValue": null,
      "description": "{\"value\":\"The U.S. Census Bureau prepared these calculations using the existing size of the U.S. House of Representatives (435 members) and the Method of Equal Proportions, as provided for in Title 2, United States Code, Sections 2a and 2b.\",\"fieldValueType\":\"countOrAmount\"}"
    },
    {
