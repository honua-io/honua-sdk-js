{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/zero-to-map-console-receipt.v1.json",
  "title": "Honua zero-to-map Console approval receipt",
  "type": "object",
  "required": ["schemaVersion", "journeyId", "releaseContract", "status", "proposals", "publications", "audit", "resources", "candidate", "checks", "shareUrl"],
  "properties": {
    "schemaVersion": { "const": "honua.zero-to-map.console-receipt/v1" },
    "journeyId": { "const": "2026.1-zero-to-map" },
    "releaseContract": { "const": "honua-release#123/D9.3" },
    "status": { "const": "passed" },
    "proposals": { "$ref": "#/$defs/studioFamiliesProposal" },
    "publications": { "$ref": "#/$defs/studioFamiliesPublication" },
    "audit": { "$ref": "#/$defs/studioFamiliesAudit" },
    "resources": {
      "type": "object",
      "required": ["connectionId", "serviceId", "layerIds", "jobs", "gp", "artifactId", "studio"],
      "properties": {
        "connectionId": { "type": "string", "minLength": 1 },
        "serviceId": { "type": "string", "minLength": 1 },
        "layerIds": {
          "type": "object",
          "required": ["parcels", "zoning"],
          "properties": {
            "parcels": { "type": "integer", "minimum": 0 },
            "zoning": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "jobs": {
          "type": "object",
          "required": ["esriMcp", "gpServer", "directAnalysis"],
          "properties": {
            "esriMcp": { "type": "string", "minLength": 1 },
            "gpServer": { "type": "string", "minLength": 1 },
            "directAnalysis": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "gp": {
          "type": "object",
          "required": ["jobId", "serviceId", "taskName", "processId", "resultPackageId", "artifactId"],
          "properties": {
            "jobId": { "type": "string", "minLength": 1 },
            "serviceId": { "const": "analysis" },
            "taskName": { "const": "Buffer" },
            "processId": { "const": "geometry.buffer" },
            "resultPackageId": { "type": "string", "minLength": 1 },
            "artifactId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "gpServerResultNames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "artifactId": { "type": "string", "minLength": 1 },
        "studio": { "$ref": "#/$defs/studioFamiliesResource" }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidateId", "releaseId"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "releaseId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["health", "audit", "recovery"],
      "properties": {
        "health": { "const": "passed" },
        "audit": { "const": "passed" },
        "recovery": { "const": "passed" }
      },
      "additionalProperties": false
    },
    "shareUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "$defs": {
    "studioFamiliesProposal": {
      "type": "object",
      "required": ["map", "app", "dashboard"],
      "properties": { "map": { "$ref": "#/$defs/studioProposal" }, "app": { "$ref": "#/$defs/studioProposal" }, "dashboard": { "$ref": "#/$defs/studioProposal" } },
      "additionalProperties": false
    },
    "studioProposal": {
      "type": "object",
      "required": ["draftId", "generation", "route", "proposalId", "executionOperationId"],
      "properties": {
        "draftId": { "type": "string", "format": "uuid" },
        "generation": { "type": "integer", "minimum": 1 },
        "route": { "type": "string", "minLength": 1 },
        "proposalId": { "type": "string", "format": "uuid" },
        "executionOperationId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "studioFamiliesPublication": {
      "type": "object",
      "required": ["map", "app", "dashboard"],
      "properties": { "map": { "$ref": "#/$defs/studioPublication" }, "app": { "$ref": "#/$defs/studioPublication" }, "dashboard": { "$ref": "#/$defs/studioPublication" } },
      "additionalProperties": false
    },
    "studioPublication": {
      "type": "object",
      "required": ["requestId", "itemId", "versionId", "status", "publicationId", "publicUrl"],
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "itemId": { "type": "string", "format": "uuid" },
        "versionId": { "type": "string", "format": "uuid" },
        "status": { "const": "published" },
        "publicationId": { "type": "string", "minLength": 1 },
        "publicUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "additionalProperties": false
    },
    "studioFamiliesAudit": {
      "type": "object",
      "required": ["map", "app", "dashboard"],
      "properties": { "map": { "$ref": "#/$defs/studioAudit" }, "app": { "$ref": "#/$defs/studioAudit" }, "dashboard": { "$ref": "#/$defs/studioAudit" } },
      "additionalProperties": false
    },
    "studioAudit": {
      "type": "object",
      "required": ["correlationId", "operationId"],
      "properties": { "correlationId": { "type": "string", "minLength": 1 }, "operationId": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "studioFamiliesResource": {
      "type": "object",
      "required": ["map", "app", "dashboard"],
      "properties": { "map": { "$ref": "#/$defs/studioFamily" }, "app": { "$ref": "#/$defs/studioFamily" }, "dashboard": { "$ref": "#/$defs/studioFamily" } },
      "additionalProperties": false
    },
    "studioFamily": {
      "type": "object",
      "required": ["draftId", "itemId", "versionId", "contentHash", "reopenedDraftId"],
      "properties": {
        "draftId": { "type": "string", "format": "uuid" },
        "itemId": { "type": "string", "format": "uuid" },
        "versionId": { "type": "string", "format": "uuid" },
        "contentHash": { "type": "string", "minLength": 1 },
        "reopenedDraftId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
