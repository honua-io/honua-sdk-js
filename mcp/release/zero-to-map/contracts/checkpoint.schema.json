{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/zero-to-map-checkpoint.v1.json",
  "title": "Honua zero-to-map pause/resume checkpoint",
  "type": "object",
  "required": ["schemaVersion", "state", "createdAt", "journeyId", "releaseContract", "target", "planSha256", "sourceRevision", "mcpEndpointSha256", "candidateId", "releaseId", "resume", "consoleReceiptRequest", "integrity"],
  "properties": {
    "schemaVersion": { "const": "honua.zero-to-map.checkpoint/v1" },
    "state": { "enum": ["paused", "consumed"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "journeyId": { "type": "string", "minLength": 1 },
    "releaseContract": { "type": "string", "minLength": 1 },
    "target": { "enum": ["local-docker", "aws-ecs"] },
    "planSha256": { "$ref": "#/$defs/sha256" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "mcpEndpointSha256": { "$ref": "#/$defs/sha256" },
    "candidateId": { "type": "string", "minLength": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "provisionReceiptSha256": { "$ref": "#/$defs/sha256" },
    "resume": {
      "type": "object",
      "required": ["startedAt", "capturedVariables", "completedStages", "resumeAt"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "capturedVariables": { "type": "object" },
        "completedStages": { "type": "array", "items": { "$ref": "#/$defs/stageReceipt" } },
        "resumeAt": {
          "type": "object",
          "required": ["stageId", "actionId"],
          "properties": { "stageId": { "const": "console" }, "actionId": { "const": "console-approval" } },
          "additionalProperties": false
        },
        "catalog": { "$ref": "#/$defs/catalogReceipt" }
      },
      "additionalProperties": false
    },
    "consoleReceiptRequest": {
      "type": "object",
      "required": ["schemaVersion", "actionId", "receiptSchema", "matches", "requiredPointers", "equalPointers"],
      "properties": {
        "schemaVersion": { "const": "honua.zero-to-map.console-receipt-request/v1" },
        "actionId": { "const": "console-approval" },
        "receiptSchema": { "const": "honua.zero-to-map.console-receipt/v1" },
        "matches": { "type": "object" },
        "requiredPointers": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
        "equalPointers": {
          "type": "array",
          "items": { "type": "array", "prefixItems": [{ "type": "string", "pattern": "^/" }, { "type": "string", "pattern": "^/" }], "items": false }
        }
      },
      "additionalProperties": false
    },
    "consumedAt": { "type": "string", "format": "date-time" },
    "finalReceiptSha256": { "$ref": "#/$defs/sha256" },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "properties": { "algorithm": { "const": "sha256" }, "digest": { "$ref": "#/$defs/sha256" } },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "catalogReceipt": {
      "$comment": "Catalog preflight evidence carried across the Console pause. Stages 6 and 7 issue no MCP action, so a resumed run cannot re-derive it and its final receipt would otherwise overwrite the pre-pause one with no catalog evidence.",
      "type": "object",
      "required": [
        "schemaVersion",
        "activeProfiles",
        "expectedTotalTools",
        "advertisedTotalTools",
        "baseStaticTools",
        "baseAdminTools",
        "auditedExclusions",
        "profiles",
        "catalogSha256",
        "adminRosterSha256",
        "staticRosterSha256",
        "exclusionRosterSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "honua.zero-to-map.catalog/v1" },
        "activeProfiles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "expectedTotalTools": { "type": "integer", "minimum": 0 },
        "advertisedTotalTools": { "type": "integer", "minimum": 0 },
        "baseStaticTools": { "type": "integer", "minimum": 0 },
        "baseAdminTools": { "type": "integer", "minimum": 0 },
        "auditedExclusions": { "type": "integer", "minimum": 0 },
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/profileReceipt" } },
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "adminRosterSha256": { "$ref": "#/$defs/sha256" },
        "staticRosterSha256": { "$ref": "#/$defs/sha256" },
        "exclusionRosterSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "profileReceipt": {
      "type": "object",
      "required": ["id", "expectedMembers", "advertisedMembers", "confirmedMembers", "nameResolvedMembers", "rosterSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "expectedMembers": { "type": "integer", "minimum": 0 },
        "advertisedMembers": { "type": "integer", "minimum": 0 },
        "confirmedMembers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "nameResolvedMembers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rosterSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "stageReceipt": {
      "type": "object",
      "required": ["number", "id", "title", "status", "actions"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "passed" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/actionReceipt" } }
      },
      "additionalProperties": false
    },
    "actionReceipt": {
      "type": "object",
      "required": ["id", "kind", "status", "startedAt", "finishedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["cli", "mcp", "mcp-resource", "gpserver", "receipt", "http"] },
        "status": { "const": "passed" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "evidence": { "type": "object" },
        "captures": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "consumed" } } },
      "then": { "required": ["consumedAt", "finalReceiptSha256"] },
      "else": { "not": { "anyOf": [{ "required": ["consumedAt"] }, { "required": ["finalReceiptSha256"] }] } }
    },
    {
      "if": { "properties": { "target": { "const": "aws-ecs" } } },
      "then": { "required": ["provisionReceiptSha256"] },
      "else": { "not": { "required": ["provisionReceiptSha256"] } }
    }
  ],
  "additionalProperties": false
}
